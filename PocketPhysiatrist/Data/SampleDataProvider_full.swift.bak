        let assessment5 = MedicalContent(
            title: "Lachman's Test",
            subtitle: nil,
            contentType: .assessment,
            category: "Assessment Tools",
            overview: "",
            keywords: []
        )

        let assessment5Section0 = ContentSection(
            title: "Purpose and Clinical Indication",
            content: "The Lachman's test is a physical examination maneuver used to assess the integrity of the Anterior Cruciate Ligament (ACL) of the knee. It is considered the most sensitive and specific clinical test for diagnosing an acute ACL tear. The test is indicated for any patient with a suspected knee injury, particularly if the mechanism involved a sudden stop, pivot, or direct blow to the knee.",
            displayType: .text,
            orderIndex: 0
        )
        assessment5.sections.append(assessment5Section0)

        let assessment5Section1 = ContentSection(
            title: "Step-by-Step Description of Assessment",
            content: "",
            displayType: .list,
            orderIndex: 1
        )
        assessment5.sections.append(assessment5Section1)

        let assessment5Section2 = ContentSection(
            title: "Detailed Scoring and Interpretation",
            content: "",
            displayType: .scale,
            tableData: [],
            orderIndex: 2
        )
        assessment5.sections.append(assessment5Section2)

        let assessment5Section3 = ContentSection(
            title: "Clinical Pearls, Contraindications, or Pitfalls",
            content: "• Patient Relaxation: The accuracy of the test is highly dependent on the patient's ability to relax their hamstring muscles. Guarding can produce a false-negative result.\\n• Comparison: Always compare the amount of translation and the quality of the endpoint to the uninjured contralateral knee.\\n• Superiority: The Lachman's test is generally considered superior to the anterior drawer test for diagnosing acute ACL injuries.",
            displayType: .list,
            orderIndex: 3
        )
        assessment5.sections.append(assessment5Section3)

        let assessment5Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Applicable in Guides: Musculoskeletal & Sports Medicine.",
            displayType: .list,
            orderIndex: 4
        )
        assessment5.sections.append(assessment5Section4)

        let assessment5Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        assessment5.sections.append(assessment5Section5)
        context.insert(assessment5)

        let assessment6 = MedicalContent(
            title: "Phalen's Test and Tinel's Sign",
