        assessment4.sections.append(assessment4Section1)

        let assessment4Row2_0 = TableRow(cells: ["S", "c", "o", "r", "i", "n", "g", ":", " ", "T", "h", "e", " ", "p", "r", "i", "m", "a", "r", "y", " ", "o", "u", "t", "c", "o", "m", "e", " ", "i", "s", " ", "t", "h", "e", " ", "t", "o", "t", "a", "l", " ", "d", "i", "s", "t", "a", "n", "c", "e", " ", "w", "a", "l", "k", "e", "d", " ", "i", "n", " ", "6", " ", "m", "i", "n", "u", "t", "e", "s", ",", " ", "m", "e", "a", "s", "u", "r", "e", "d", " ", "i", "n", " ", "m", "e", "t", "e", "r", "s", "."], isHeader: true)
        let assessment4Row2_1 = TableRow(cells: ["I", "n", "t", "e", "r", "p", "r", "e", "t", "a", "t", "i", "o", "n", ":", " ", "T", "h", "e", " ", "d", "i", "s", "t", "a", "n", "c", "e", " ", "w", "a", "l", "k", "e", "d", " ", "i", "s", " ", "c", "o", "m", "p", "a", "r", "e", "d", " ", "t", "o", " ", "n", "o", "r", "m", "a", "t", "i", "v", "e", " ", "v", "a", "l", "u", "e", "s", " ", "b", "a", "s", "e", "d", " ", "o", "n", " ", "a", "g", "e", ",", " ", "s", "e", "x", ",", " ", "h", "e", "i", "g", "h", "t", ",", " ", "a", "n", "d", " ", "w", "e", "i", "g", "h", "t", ".", " ", "A", " ", "l", "o", "w", "e", "r", "-", "t", "h", "a", "n", "-", "p", "r", "e", "d", "i", "c", "t", "e", "d", " ", "d", "i", "s", "t", "a", "n", "c", "e", " ", "i", "n", "d", "i", "c", "a", "t", "e", "s", " ", "r", "e", "d", "u", "c", "e", "d", " ", "f", "u", "n", "c", "t", "i", "o", "n", "a", "l", " ", "c", "a", "p", "a", "c", "i", "t", "y", ".", " ", "C", "h", "a", "n", "g", "e", "s", " ", "i", "n", " ", "t", "h", "e", " ", "d", "i", "s", "t", "a", "n", "c", "e", " ", "w", "a", "l", "k", "e", "d", " ", "o", "v", "e", "r", " ", "t", "i", "m", "e", " ", "c", "a", "n", " ", "b", "e", " ", "u", "s", "e", "d", " ", "t", "o", " ", "t", "r", "a", "c", "k", " ", "d", "i", "s", "e", "a", "s", "e", " ", "p", "r", "o", "g", "r", "e", "s", "s", "i", "o", "n", " ", "o", "r", " ", "i", "m", "p", "r", "o", "v", "e", "m", "e", "n", "t", " ", "w", "i", "t", "h", " ", "t", "h", "e", "r", "a", "p", "y", "."], isHeader: false)
