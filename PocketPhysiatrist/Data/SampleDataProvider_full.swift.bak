        )

        let assessment6Section0 = ContentSection(
            title: "Purpose and Clinical Indication",
            content: "Phalen's test and Tinel's sign are provocative maneuvers used in the physical examination to help diagnose Carpal Tunnel Syndrome (CTS), which is compression of the median nerve at the wrist.",
            displayType: .text,
            orderIndex: 0
        )
        assessment6.sections.append(assessment6Section0)

        let assessment6Section1 = ContentSection(
            title: "Step-by-Step Description of Assessment",
