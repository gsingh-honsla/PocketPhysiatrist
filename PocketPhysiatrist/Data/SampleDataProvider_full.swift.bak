        let guide3Row1_4 = TableRow(cells: ["U", "n", "s", "t", "a", "g", "e", "a", "b", "l", "e", ":", " ", "F", "u", "l", "l", "-", "t", "h", "i", "c", "k", "n", "e", "s", "s", " ", "s", "k", "i", "n", " ", "a", "n", "d", " ", "t", "i", "s", "s", "u", "e", " ", "l", "o", "s", "s", " ", "i", "n", " ", "w", "h", "i", "c", "h", " ", "t", "h", "e", " ", "e", "x", "t", "e", "n", "t", " ", "o", "f", " ", "d", "a", "m", "a", "g", "e", " ", "c", "a", "n", "n", "o", "t", " ", "b", "e", " ", "c", "o", "n", "f", "i", "r", "m", "e", "d", " ", "b", "e", "c", "a", "u", "s", "e", " ", "i", "t", " ", "i", "s", " ", "o", "b", "s", "c", "u", "r", "e", "d", " ", "b", "y", " ", "s", "l", "o", "u", "g", "h", " ", "(", "y", "e", "l", "l", "o", "w", ",", " ", "t", "a", "n", ",", " ", "g", "r", "a", "y", ",", " ", "g", "r", "e", "e", "n", ",", " ", "o", "r", " ", "b", "r", "o", "w", "n", ")", " ", "o", "r", " ", "e", "s", "c", "h", "a", "r", " ", "(", "t", "a", "n", ",", " ", "b", "r", "o", "w", "n", ",", " ", "o", "r", " ", "b", "l", "a", "c", "k", ")", "."], isHeader: false)
        let guide3Row1_5 = TableRow(cells: ["D", "e", "e", "p", " ", "T", "i", "s", "s", "u", "e", " ", "P", "r", "e", "s", "s", "u", "r", "e", " ", "I", "n", "j", "u", "r", "y", " ", "(", "D", "T", "P", "I", ")", ":", " ", "I", "n", "t", "a", "c", "t", " ", "o", "r", " ", "n", "o", "n", "-", "i", "n", "t", "a", "c", "t", " ", "s", "k", "i", "n", " ", "w", "i", "t", "h", " ", "a", " ", "l", "o", "c", "a", "l", "i", "z", "e", "d", " ", "a", "r", "e", "a", " ", "o", "f", " ", "p", "e", "r", "s", "i", "s", "t", "e", "n", "t", " ", "n", "o", "n", "-", "b", "l", "a", "n", "c", "h", "a", "b", "l", "e", " ", "d", "e", "e", "p", " ", "r", "e", "d", ",", " ", "m", "a", "r", "o", "o", "n", ",", " ", "o", "r", " ", "p", "u", "r", "p", "l", "e", " ", "d", "i", "s", "c", "o", "l", "o", "r", "a", "t", "i", "o", "n", ",", " ", "o", "r", " ", "a", " ", "b", "l", "o", "o", "d", "-", "f", "i", "l", "l", "e", "d", " ", "b", "l", "i", "s", "t", "e", "r", " ", "d", "u", "e", " ", "t", "o", " ", "d", "a", "m", "a", "g", "e", " ", "o", "f", " ", "u", "n", "d", "e", "r", "l", "y", "i", "n", "g", " ", "s", "o", "f", "t", " ", "t", "i", "s", "s", "u", "e", " ", "f", "r", "o", "m", " ", "p", "r", "e", "s", "s", "u", "r", "e", " ", "a", "n", "d", "/", "o", "r", " ", "s", "h", "e", "a", "r", "."], isHeader: false)
        let guide3Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Staging",
            content: "",
            displayType: .scale,
            tableData: [guide3Row1_0, guide3Row1_1, guide3Row1_2, guide3Row1_3, guide3Row1_4, guide3Row1_5],
            orderIndex: 1
        )
        guide3.sections.append(guide3Section1)

        let guide3Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Prevention is Paramount:**\\n• Pressure Relief:: This is the single most important strategy.\\n• In Bed:: Repositioning at least every 2 hours.\\n• In Wheelchair:: Performing pressure reliefs (weight shifts) for 1-3 minutes every 15-30 minutes. Power wheelchair users can use tilt and recline functions.\\n• Daily Skin Inspections:: A thorough skin check should be performed at least twice daily, using a mirror for hard-to-see areas, to identify any redness or signs of breakdown early.\\n• Support Surfaces:: Use of appropriate pressure-reducing cushions for wheelchairs and mattresses for beds is essential.\\n• Skin Care:: Keep skin clean and dry. Use mild cleansers and avoid vigorous massage over bony areas.\\n• Nutrition:: Adequate intake of protein, calories, vitamins, and fluids is crucial for maintaining skin integrity and promoting healing.\\n• **Management of Existing Pressure Injuries:**\\n• Eliminate Pressure:: All pressure must be removed from the affected area. This may require strict bed rest, which can lead to other complications and significant life disruption.\\n• Wound Care:: The goal is to create a moist wound healing environment.\\n• Cleansing:: Cleanse the wound with normal saline or a prescribed cleanser at each dressing change. Irrigation pressure should be sufficient to clean but not traumatize the wound bed (4-15 psi).\\n• Debridement:: Removal of necrotic tissue (slough, eschar) is necessary for healing. This can be done surgically, mechanically (e.g., wet-to-dry dressings, pulse lavage), or enzymatically (using topical agents like collagenase).\\n• *Exception: Stable, dry eschar on the heel should not be removed.*\\n• Dressings:: The choice of dressing depends on the wound stage, depth, and amount of drainage. Options range from transparent films for Stage 1 to absorptive dressings like alginates or foams for heavily draining wounds.\\n• Infection Management:: If signs of infection are present (increased drainage, foul odor, greenish drainage, surrounding redness/warmth, fever), a wound culture and systemic antibiotics may be necessary. Osteomyelitis (bone infection) is a serious complication of deep PIs.\\n• Surgical Management:: For non-healing Stage 3 and Stage 4 injuries, surgical intervention with a flap reconstruction may be required to close the wound.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide3.sections.append(guide3Section2)

        let guide3Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Infection:: Can range from local cellulitis to systemic sepsis or osteomyelitis. Requires appropriate antibiotic therapy and debridement.\\n• Autonomic Dysreflexia:: A pressure injury can be a potent trigger for AD in individuals with injuries at T6 or above.\\n• Delayed Healing:: Healing time varies significantly by stage. A Stage 1 PI may resolve in days, while a Stage 4 PI can take months to years to heal, even with optimal care.\\n• Recurrence:: PIs have a high rate of recurrence. Lifelong adherence to prevention strategies is critical.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide3.sections.append(guide3Section3)

        let guide3Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Autonomic Dysreflexia.\\n• Referenced Assessment Tools: American Spinal Injury Association (ASIA) Impairment Scale.",
            displayType: .list,
            orderIndex: 4
        )
        guide3.sections.append(guide3Section4)

        let guide3Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide3.sections.append(guide3Section5)
        context.insert(guide3)

        let guide4 = MedicalContent(
            title: "Orthostatic Hypotension in SCI",
            subtitle: nil,
            contentType: .category,
            category: "Spinal Cord Injury (SCI) Medicine",
            overview: "A rotation on the Spinal Cord Injury (SCI) Medicine service provides foundational training in the comprehensive, lifelong management of individuals with both traumatic and non-traumatic myelopathies. The physiatrist functions as the leader of a robust interdisciplinary team, which includes physical and occupational therapists, speech-language pathologists, rehabilitation nurses, psychologists, social workers, and various medical and surgical consultants. The primary objective is to address the multitude of secondary health conditions that arise after SCI, such as neurogenic bladder and bowel dysfunction, spasticity, chronic pain, pressure injuries, and autonomic dysreflexia, with the overarching goal of maximizing the patient's functional independence, community reintegration, and quality of life.  \n\nTrainees on this service will develop expertise across the entire continuum of care, from initial acute care consultations in the trauma bay and intensive care unit to the intensive rehabilitation phase and long-term outpatient management. Core competencies include performing a comprehensive neurological examination, most notably the International Standards for Neurological Classification of Spinal Cord Injury (ISNCSCI) or ASIA exam, and developing a functionally oriented management plan. This plan addresses not only the immediate rehabilitation needs but also the prevention and treatment of lifelong medical complications inherent to this patient population.",
            keywords: []
        )

        let guide4Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Orthostatic hypotension (OH) is a common form of cardiovascular dysfunction following SCI, defined as a drop in systolic blood pressure of at least 20 mmHg or diastolic blood pressure of at least 10 mmHg within three minutes of moving to an upright position (e.g., standing or sitting up). It is most prevalent and severe in individuals with complete lesions above the T6 neurological level, particularly during the acute phase of injury.  \n\nThe primary cause of OH in SCI is the disruption of the sympathetic nervous system pathways that are responsible for cardiovascular regulation. In an uninjured person, moving upright causes blood to pool in the legs and abdomen due to gravity. Baroreceptors detect the resulting drop in blood pressure and trigger a reflex sympathetic response, causing vasoconstriction to increase peripheral resistance and maintain blood pressure. In an SCI above T6, these descending sympathetic signals are blocked. As a result, the blood vessels in the abdomen and lower extremities remain dilated, leading to significant venous pooling and a sharp fall in blood pressure upon sitting or standing. This is compounded by the loss of the skeletal muscle pump in paralyzed limbs.  \n\nClinical symptoms are primarily due to cerebral hypoperfusion (insufficient blood flow to the brain) and can include :  \n\n Dizziness or light-headedness  \n Syncope (fainting) or near-syncope  \n Blurred vision, tunnel vision, or seeing spots  \n Generalized weakness or fatigue  \n Nausea  \n \"Coat hanger\" headache (pain in the neck and shoulders)",
            displayType: .text,
            orderIndex: 0
        )
        guide4.sections.append(guide4Section0)

        let guide4Section1 = ContentSection(
            title: "Key Diagnostic Criteria",
            content: "• The diagnosis of OH is clinical, based on measuring blood pressure and heart rate in supine and upright positions and correlating the findings with the patient's symptoms.\\n• A tilt-table test can be used for a more controlled assessment.\\n• Laboratory tests, such as a complete blood count and electrolytes, are primarily used to rule out other contributing causes like anemia or dehydration.\\n• It is important to review the patient's medications, as many common drugs (e.g., antihypertensives, some muscle relaxants like tizanidine, and tricyclic antidepressants) can induce or worsen OH.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide4.sections.append(guide4Section1)

        let guide4Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Non-Pharmacologic Management:: This is the first line of treatment.\\n• Gradual Mobilization:: Slowly acclimate the patient to upright postures. This often begins with elevating the head of the bed and progressing to a reclining or tilt-in-space wheelchair, and eventually a tilt-table.\\n• Compression Garments:: An abdominal binder is highly effective at reducing splanchnic venous pooling. Compression stockings (thigh-high or waist-high) can help reduce pooling in the lower extremities.\\n• Fluid and Salt Intake:: Ensuring adequate hydration is crucial. Liberalizing salt intake can help expand intravascular volume, but must be balanced with bladder and bowel management needs.\\n• Patient Education:: Teach patients to avoid rapid positional changes, especially in the morning. Instruct them on physical counter-maneuvers like crossing their legs or tensing their muscles if they feel symptomatic.\\n• Functional Electrical Stimulation (FES):: FES applied to the leg and abdominal muscles can help activate the muscle pump to increase venous return and blood pressure.\\n• Pharmacologic Management:: Medications are used when non-pharmacologic measures are insufficient.\\n• Midodrine:: An alpha-1 adrenergic agonist that causes peripheral vasoconstriction. It is a first-line agent for treating neurogenic OH.\\n• Fludrocortisone:: A mineralocorticoid that increases sodium and water retention, thereby expanding blood volume.\\n• Droxidopa:: A synthetic precursor to norepinephrine that increases peripheral vascular resistance. It is also FDA-approved for neurogenic OH.\\n• Other Agents:: Pyridostigmine and atomoxetine may also be considered in some cases.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide4.sections.append(guide4Section2)

        let guide4Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• The primary complication of OH is syncope, which can lead to falls and secondary injuries.\\n• Chronic OH can severely limit participation in rehabilitation and activities of daily living.\\n• Management requires a coordinated approach, for example, scheduling therapy sessions in the afternoon when blood pressure may be naturally higher, and avoiding large meals immediately before physical activity, as this can cause postprandial hypotension.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide4.sections.append(guide4Section3)

        let guide4Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Autonomic Dysreflexia.\\n• Referenced Assessment Tools: American Spinal Injury Association (ASIA) Impairment Scale.",
            displayType: .list,
            orderIndex: 4
        )
        guide4.sections.append(guide4Section4)

        let guide4Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide4.sections.append(guide4Section5)
        context.insert(guide4)

        let guide5 = MedicalContent(
            title: "Disorders of Consciousness (DOC) after TBI",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide5Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Following a severe traumatic brain injury (TBI), patients may experience profound alterations in consciousness. These states exist on a continuum of recovery, and accurate diagnosis is critical for prognosis and management. The primary states are Coma, Vegetative State (VS), and Minimally Conscious State (MCS).  \n\n Coma: A state of unarousable unresponsiveness. Patients in a coma have no eye-opening, cannot follow commands, do not produce purposeful movements, and have no speech or communication. Coma is typically a transient state, rarely lasting more than a few weeks.    \n Vegetative State (VS): A condition of \"wakeful unconsciousness.\" Patients in a VS have recovered sleep-wake cycles and may open their eyes spontaneously, but they show no signs of awareness of self or the environment. They do not follow commands, communicate, or demonstrate reproducible, purposeful behaviors in response to stimuli. Movements are reflexive (e.g., startle, postural adjustments). The term \"persistent\" VS is used when the state lasts for more than one month.    \n Minimally Conscious State (MCS): This state is distinguished from VS by the presence of inconsistent but clearly discernible, reproducible evidence of awareness. The hallmark of MCS is this inconsistency; a patient may follow a command on one examination but not on a subsequent one. Key behaviors that define MCS include:    \n   Following simple commands (e.g., \"squeeze my hand\").    \n   Intelligible verbalization (even single words).    \n   Reliable \"yes/no\" responses (gestural or verbal).    \n  * Purposeful behaviors that are not reflexive, such as reaching for objects, holding and using an object appropriately, or sustained visual fixation and pursuit.  \n\nEmergence from MCS is marked by the return of reliable interactive communication or the functional use of two different objects.",
            displayType: .text,
            orderIndex: 0
        )
        guide5.sections.append(guide5Section0)

        let guide5Row1_0 = TableRow(cells: ["G", "l", "a", "s", "g", "o", "w", " ", "C", "o", "m", "a", " ", "S", "c", "a", "l", "e", " ", "(", "G", "C", "S", ")", ":", " ", "U", "s", "e", "d", " ", "t", "o", " ", "a", "s", "s", "e", "s", "s", " ", "t", "h", "e", " ", "i", "n", "i", "t", "i", "a", "l", " ", "s", "e", "v", "e", "r", "i", "t", "y", " ", "o", "f", " ", "a", " ", "b", "r", "a", "i", "n", " ", "i", "n", "j", "u", "r", "y", " ", "b", "y", " ", "s", "c", "o", "r", "i", "n", "g", " ", "e", "y", "e", "-", "o", "p", "e", "n", "i", "n", "g", ",", " ", "v", "e", "r", "b", "a", "l", " ", "r", "e", "s", "p", "o", "n", "s", "e", ",", " ", "a", "n", "d", " ", "m", "o", "t", "o", "r", " ", "r", "e", "s", "p", "o", "n", "s", "e", ".", " ", "I", "t", " ", "i", "s", " ", "p", "r", "i", "m", "a", "r", "i", "l", "y", " ", "u", "s", "e", "d", " ", "i", "n", " ", "t", "h", "e", " ", "a", "c", "u", "t", "e", " ", "e", "m", "e", "r", "g", "e", "n", "c", "y", " ", "s", "e", "t", "t", "i", "n", "g", "."], isHeader: true)
        let guide5Row1_1 = TableRow(cells: ["J", "F", "K", " ", "C", "o", "m", "a", " ", "R", "e", "c", "o", "v", "e", "r", "y", " ", "S", "c", "a", "l", "e", "-", "R", "e", "v", "i", "s", "e", "d", " ", "(", "C", "R", "S", "-", "R", ")", ":", " ", "T", "h", "i", "s", " ", "i", "s", " ", "t", "h", "e", " ", "g", "o", "l", "d", " ", "s", "t", "a", "n", "d", "a", "r", "d", " ", "f", "o", "r", " ", "d", "i", "f", "f", "e", "r", "e", "n", "t", "i", "a", "t", "i", "n", "g", " ", "b", "e", "t", "w", "e", "e", "n", " ", "V", "S", " ", "a", "n", "d", " ", "M", "C", "S", ".", " ", "I", "t", " ", "i", "s", " ", "a", " ", "h", "i", "g", "h", "l", "y", " ", "s", "t", "r", "u", "c", "t", "u", "r", "e", "d", " ", "a", "s", "s", "e", "s", "s", "m", "e", "n", "t", " ", "t", "h", "a", "t", " ", "s", "y", "s", "t", "e", "m", "a", "t", "i", "c", "a", "l", "l", "y", " ", "c", "h", "e", "c", "k", "s", " ", "f", "o", "r", " ", "r", "e", "s", "p", "o", "n", "s", "e", "s", " ", "t", "o", " ", "a", "u", "d", "i", "t", "o", "r", "y", ",", " ", "v", "i", "s", "u", "a", "l", ",", " ", "m", "o", "t", "o", "r", ",", " ", "o", "r", "o", "m", "o", "t", "o", "r", ",", " ", "c", "o", "m", "m", "u", "n", "i", "c", "a", "t", "i", "o", "n", ",", " ", "a", "n", "d", " ", "a", "r", "o", "u", "s", "a", "l", " ", "s", "t", "i", "m", "u", "l", "i", "."], isHeader: false)
        let guide5Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Classification Systems",
            content: "",
            displayType: .scale,
            tableData: [guide5Row1_0, guide5Row1_1],
            orderIndex: 1
        )
        guide5.sections.append(guide5Section1)

        let guide5Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Medical Management:**\\n• Preventing Complications:: This is a cornerstone of care and includes meticulous skin care to prevent pressure injuries, regular turning and positioning, management of spasticity and contractures, and maintaining bowel and bladder continence.\\n• Nutritional Support:: Patients require enteral feeding via a feeding tube to maintain nutrition and hydration.\\n• **Pharmacologic Intervention:**\\n• Amantadine:: This is the only medication with strong evidence to accelerate the pace of recovery for patients in VS or MCS following a TBI when administered between 4 and 16 weeks post-injury.\\n• Other Neurostimulants:: Other medications like levodopa or zolpidem may be trialed, but evidence is less robust.\\n• It is critical to discontinue or minimize the use of sedating medications that can suppress arousal and awareness.\\n• **Rehabilitative Management:**\\n• Sensory Stimulation:: While evidence for its efficacy is mixed, structured sensory stimulation programs (multimodal stimulation) are often implemented to provide auditory, visual, tactile, and olfactory input in an attempt to increase arousal and awareness.\\n• Physical and Occupational Therapy:: Focuses on maintaining range of motion, managing tone and spasticity, and providing proper seating and positioning to prevent complications and prepare the patient for more active participation if they emerge.\\n• Upright Positioning:: Getting patients out of bed and into a specialized wheelchair, or using a tilt table for verticalization, is important for medical stability and has been shown to increase brain activation.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide5.sections.append(guide5Section2)

        let guide5Section3 = ContentSection(
            title: "Common Complications and Prognosis",
            content: "Prognosis for recovery of consciousness is better after traumatic than non-traumatic (e.g., anoxic) brain injury and is better for MCS than for VS. Of those in a VS one month after a TBI, up to 90% may regain consciousness within a year, though they are likely to have significant ongoing disabilities. Family education and support are critical components of care, helping families understand the diagnosis, prognosis, and how to interact with their loved one.",
            displayType: .text,
            orderIndex: 3
        )
        guide5.sections.append(guide5Section3)

        let guide5Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Agitation and Aggression after TBI, Post-Traumatic Spasticity.\\n• Referenced Assessment Tools: Rancho Los Amigos Scale (LCFS), JFK Coma Recovery Scale-Revised (CRS-R).",
            displayType: .list,
            orderIndex: 4
        )
        guide5.sections.append(guide5Section4)

        let guide5Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide5.sections.append(guide5Section5)
        context.insert(guide5)

        let guide6 = MedicalContent(
            title: "Agitation and Aggression after TBI",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide6Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Agitation and aggression are common and challenging behavioral sequelae following traumatic brain injury (TBI). Agitation is a state of excessive motor activity, often non-purposeful, accompanied by internal restlessness and emotional distress. Aggression refers to hostile or violent behavior, which can be verbal or physical.  \n\nThese behaviors are most common during the acute and subacute phases of recovery, particularly as a patient emerges from a disorder of consciousness and enters a state of post-traumatic amnesia (PTA). This phase is characterized by profound confusion, disorientation, and an inability to form new memories, which can be frightening and distressing for the patient, leading to agitated behaviors. The Rancho Los Amigos Scale describes this phase as Level IV \\- Confused/Agitated.  \n\nThe underlying pathophysiology is related to damage to the frontal lobes, temporal lobes, and limbic system, which are responsible for executive functions like impulse control, emotional regulation, and social judgment. The injury disrupts the brain's ability to modulate responses to internal and external stimuli, leading to disinhibition and over-reactivity.",
            displayType: .text,
            orderIndex: 0
        )
        guide6.sections.append(guide6Section0)

        let guide6Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• Agitated Behavior Scale (ABS):: This is a standardized, 14-item observational scale used to measure the severity and track the course of agitation. A score greater than 21 indicates a clinically significant level of agitation.\\n• Rancho Los Amigos Scale (LCFS):: Helps to contextualize the agitation within the broader cognitive recovery process. Agitation is an expected feature of LCFS Level IV.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide6.sections.append(guide6Section1)

        let guide6Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Environmental Management:: This is the cornerstone of treatment. The goal is to reduce excessive stimulation and provide structure.\\n• Quiet, Calm Environment:: Place the patient in a private room if possible. Minimize noise, dim the lights, and limit the number of visitors to one or two at a time.\\n• Consistency and Routine:: Maintain a consistent daily schedule and assign consistent caregivers. This provides predictability and reduces confusion.\\n• Safety:: Create a safe space by removing potentially dangerous objects. A low bed or mattress on the floor can prevent fall-related injuries. Physical restraints should be avoided as they often increase agitation and can cause injury.\\n• **Behavioral Management:**\\n• Calm and Reassuring Approach:: Staff and family should interact with the patient in a calm, soft, and low-toned voice. Avoid arguing, confronting, or taking behaviors personally.\\n• Redirection and Distraction:: When the patient becomes agitated, gently redirect their attention to a different, calming activity. Do not try to reason with or logically explain things to a confused and agitated patient.\\n• Offer Choices:: Providing simple choices can help the patient feel a sense of control.\\n• Meet Basic Needs:: Proactively address potential sources of discomfort like pain, hunger, thirst, or the need to use the toilet.\\n• Pharmacologic Management:: Medications are reserved for cases where agitation poses a significant safety risk to the patient or others and has not responded to non-pharmacologic interventions.\\n• The goal is to calm the patient without causing excessive sedation that would hinder their participation in therapy.\\n• Beta-blockers (e.g., propranolol):: Often considered a first-line option as they can reduce aggression and agitation without significant cognitive side effects.\\n• Anticonvulsants (e.g., valproate, carbamazepine):: Can be effective as mood stabilizers.\\n• Atypical Antipsychotics (e.g., olanzapine, quetiapine):: May be used for severe agitation, especially if psychotic features are present, but must be used with caution due to side effects.\\n• Benzodiazepines and typical antipsychotics (e.g., haloperidol): are generally avoided as they can worsen confusion, increase fall risk, and impede cognitive recovery.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide6.sections.append(guide6Section2)

        let guide6Section3 = ContentSection(
            title: "Common Complications and Prognosis",
            content: "Agitation is typically a transient phase of recovery and tends to resolve as the patient emerges from post-traumatic amnesia. However, aggression can sometimes persist as a long-term behavioral problem. Unmanaged agitation can disrupt therapy, prolong hospital stays, and increase the risk of injury. Family education is crucial to help them understand that agitation is a part of the brain injury recovery process and to teach them effective management strategies.",
            displayType: .text,
            orderIndex: 3
        )
        guide6.sections.append(guide6Section3)

        let guide6Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Disorders of Consciousness (DOC) after TBI.\\n• Referenced Assessment Tools: Rancho Los Amigos Scale (LCFS), Agitated Behavior Scale (ABS).",
            displayType: .list,
            orderIndex: 4
        )
        guide6.sections.append(guide6Section4)

        let guide6Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide6.sections.append(guide6Section5)
        context.insert(guide6)

        let guide7 = MedicalContent(
            title: "Post-Traumatic Headache (PTH)",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide7Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Post-traumatic headache (PTH) is defined by the International Classification of Headache Disorders (ICHD-3) as a secondary headache that develops within seven days of a head and/or neck injury, or within seven days of regaining consciousness. It is the most common symptom reported after a mild TBI (concussion). When the headache persists for longer than three months, it is termed  \n\npersistent post-traumatic headache.  \n\nThe pathophysiology of PTH is complex, not yet fully elucidated, and involves a convergence of mechanisms seen in both TBI and primary headache disorders. Key proposed mechanisms include:  \n\n Neuroinflammation and Activation of the Trigeminal Sensory System: Trauma can trigger neuroinflammatory cascades and activate the trigeminal sensory system. This leads to the release of pain-mediating neuropeptides like calcitonin gene-related peptide (CGRP), a key player in migraine pathophysiology. This activation can lead to central sensitization, where the central nervous system becomes hyperexcitable and maintains a state of pain.    \n Neurometabolic Cascade and Structural Damage: The initial physical trauma can cause diffuse axonal injury and other structural changes. This is followed by a secondary injury cascade involving unregulated ion exchange, neurotransmitter release (e.g., glutamate), and metabolic stress, which can lead to further neuronal damage and contribute to pain signaling.    \n* Cervicogenic Contributions: Biomechanical forces from head trauma are often transmitted to the cervical spine, causing a whiplash-type injury. Irritation of the upper cervical nerve roots (C1-C3) can refer pain to the head via the trigeminocervical complex. Furthermore, direct irritation or compression of peripheral nerves, such as the greater occipital nerve, can cause occipital neuralgia that presents as a headache.  \n\nThe clinical presentation of PTH is notably heterogeneous, often mimicking primary headache phenotypes. The most common presentations are migraine-like (unilateral, pulsating or throbbing, moderate-to-severe intensity, associated with photophobia, phonophobia, and/or nausea) and tension-type headaches.",
            displayType: .text,
            orderIndex: 0
        )
        guide7.sections.append(guide7Section0)

        let guide7Row1_0 = TableRow(cells: ["H", "i", "s", "t", "o", "r", "y", ":", " ", "T", "h", "e", " ", "m", "o", "s", "t", " ", "c", "r", "i", "t", "i", "c", "a", "l", " ", "e", "l", "e", "m", "e", "n", "t", " ", "i", "s", " ", "e", "s", "t", "a", "b", "l", "i", "s", "h", "i", "n", "g", " ", "a", " ", "c", "l", "e", "a", "r", " ", "t", "e", "m", "p", "o", "r", "a", "l", " ", "r", "e", "l", "a", "t", "i", "o", "n", "s", "h", "i", "p", " ", "b", "e", "t", "w", "e", "e", "n", " ", "t", "h", "e", " ", "h", "e", "a", "d", "/", "n", "e", "c", "k", " ", "t", "r", "a", "u", "m", "a", " ", "a", "n", "d", " ", "t", "h", "e", " ", "o", "n", "s", "e", "t", " ", "o", "f", " ", "t", "h", "e", " ", "n", "e", "w", " ", "o", "r", " ", "s", "i", "g", "n", "i", "f", "i", "c", "a", "n", "t", "l", "y", " ", "w", "o", "r", "s", "e", "n", "e", "d", " ", "h", "e", "a", "d", "a", "c", "h", "e", ".", " ", "T", "h", "e", " ", "c", "l", "i", "n", "i", "c", "i", "a", "n", " ", "m", "u", "s", "t", " ", "t", "h", "e", "n", " ", "c", "h", "a", "r", "a", "c", "t", "e", "r", "i", "z", "e", " ", "t", "h", "e", " ", "h", "e", "a", "d", "a", "c", "h", "e", " ", "p", "h", "e", "n", "o", "t", "y", "p", "e", " ", "t", "o", " ", "g", "u", "i", "d", "e", " ", "t", "r", "e", "a", "t", "m", "e", "n", "t", ".", " ", "I", "m", "p", "o", "r", "t", "a", "n", "t", " ", "r", "i", "s", "k", " ", "f", "a", "c", "t", "o", "r", "s", " ", "f", "o", "r", " ", "d", "e", "v", "e", "l", "o", "p", "i", "n", "g", " ", "p", "e", "r", "s", "i", "s", "t", "e", "n", "t", " ", "P", "T", "H", " ", "i", "n", "c", "l", "u", "d", "e", " ", "b", "e", "i", "n", "g", " ", "f", "e", "m", "a", "l", "e", ",", " ", "y", "o", "u", "n", "g", "e", "r", " ", "a", "g", "e", ",", " ", "a", " ", "p", "e", "r", "s", "o", "n", "a", "l", " ", "o", "r", " ", "f", "a", "m", "i", "l", "y", " ", "h", "i", "s", "t", "o", "r", "y", " ", "o", "f", " ", "m", "i", "g", "r", "a", "i", "n", "e", ",", " ", "a", "n", "d", " ", "p", "r", "e", "-", "e", "x", "i", "s", "t", "i", "n", "g", " ", "p", "s", "y", "c", "h", "i", "a", "t", "r", "i", "c", " ", "c", "o", "n", "d", "i", "t", "i", "o", "n", "s", " ", "l", "i", "k", "e", " ", "a", "n", "x", "i", "e", "t", "y", " ", "o", "r", " ", "d", "e", "p", "r", "e", "s", "s", "i", "o", "n", "."], isHeader: true)
        let guide7Row1_1 = TableRow(cells: ["P", "h", "y", "s", "i", "c", "a", "l", " ", "E", "x", "a", "m", "i", "n", "a", "t", "i", "o", "n", ":", " ", "A", " ", "c", "o", "m", "p", "l", "e", "t", "e", " ", "n", "e", "u", "r", "o", "l", "o", "g", "i", "c", "a", "l", " ", "a", "n", "d", " ", "m", "u", "s", "c", "u", "l", "o", "s", "k", "e", "l", "e", "t", "a", "l", " ", "e", "x", "a", "m", "i", "n", "a", "t", "i", "o", "n", " ", "i", "s", " ", "m", "a", "n", "d", "a", "t", "o", "r", "y", ".", " ", "T", "h", "i", "s", " ", "m", "u", "s", "t", " ", "i", "n", "c", "l", "u", "d", "e", " ", "a", " ", "d", "e", "t", "a", "i", "l", "e", "d", " ", "a", "s", "s", "e", "s", "s", "m", "e", "n", "t", " ", "o", "f", " ", "t", "h", "e", " ", "c", "e", "r", "v", "i", "c", "a", "l", " ", "s", "p", "i", "n", "e", " ", "(", "r", "a", "n", "g", "e", " ", "o", "f", " ", "m", "o", "t", "i", "o", "n", ",", " ", "p", "a", "l", "p", "a", "t", "i", "o", "n", " ", "f", "o", "r", " ", "m", "y", "o", "f", "a", "s", "c", "i", "a", "l", " ", "t", "r", "i", "g", "g", "e", "r", " ", "p", "o", "i", "n", "t", "s", ")", ",", " ", "e", "v", "a", "l", "u", "a", "t", "i", "o", "n", " ", "f", "o", "r", " ", "t", "e", "m", "p", "o", "r", "o", "m", "a", "n", "d", "i", "b", "u", "l", "a", "r", " ", "j", "o", "i", "n", "t", " ", "d", "y", "s", "f", "u", "n", "c", "t", "i", "o", "n", ",", " ", "a", "n", "d", " ", "a", " ", "f", "o", "c", "u", "s", "e", "d", " ", "v", "e", "s", "t", "i", "b", "u", "l", "o", "-", "o", "c", "u", "l", "a", "r", " ", "e", "x", "a", "m", "i", "n", "a", "t", "i", "o", "n", " ", "(", "a", "s", "s", "e", "s", "s", "i", "n", "g", " ", "f", "o", "r", " ", "c", "o", "n", "v", "e", "r", "g", "e", "n", "c", "e", " ", "i", "n", "s", "u", "f", "f", "i", "c", "i", "e", "n", "c", "y", ",", " ", "s", "a", "c", "c", "a", "d", "i", "c", " ", "d", "y", "s", "f", "u", "n", "c", "t", "i", "o", "n", ")", " ", "a", "s", " ", "t", "h", "e", "s", "e", " ", "s", "y", "s", "t", "e", "m", "s", " ", "a", "