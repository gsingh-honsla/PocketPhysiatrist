        let assessment7 = MedicalContent(
            title: "Rancho Los Amigos Scale (LCFS)",
            subtitle: nil,
            contentType: .assessment,
            category: "Assessment Tools",
            overview: "",
            keywords: []
        )

        let assessment7Section0 = ContentSection(
            title: "Purpose and Clinical Indication",
            content: "The Rancho Los Amigos Scale, also known as the Level of Cognitive Functioning Scale (LCFS), is a descriptive scale used to characterize a patient's cognitive and behavioral recovery patterns after a traumatic brain injury (TBI). It provides a framework for the rehabilitation team to understand the patient's stage of recovery, anticipate behaviors, and plan appropriate interventions.",
            displayType: .text,
            orderIndex: 0
        )
        assessment7.sections.append(assessment7Section0)

        let assessment7Section1 = ContentSection(
            title: "Step-by-Step Description of Assessment",
            content: "The LCFS is not a formal test but a classification system based on clinical observation of the patient's responses to environmental stimuli. The clinician assigns a level based on the patient's behaviors.",
            displayType: .text,
            orderIndex: 1
        )
        assessment7.sections.append(assessment7Section1)

        let assessment7Row2_0 = TableRow(cells: ["Level", "Description"], isHeader: true)
        let assessment7Row2_1 = TableRow(cells: [":----", ":----"], isHeader: false)
        let assessment7Row2_2 = TableRow(cells: ["**I**", "**No Response:** Patient appears to be in a deep sleep and is completely unresponsive to any stimuli."], isHeader: false)
        let assessment7Row2_3 = TableRow(cells: ["**II**", "**Generalized Response:** Patient reacts inconsistently and non-purposefully to stimuli in a nonspecific manner. Responses are limited and often the same regardless of the stimulus presented."], isHeader: false)
        let assessment7Row2_4 = TableRow(cells: ["**III**", "**Localized Response:** Patient reacts specifically but inconsistently to stimuli. Responses are directly related to the type of stimulus presented. May follow simple commands, such as closing eyes or squeezing hand, in an inconsistent, delayed manner."], isHeader: false)
        let assessment7Row2_5 = TableRow(cells: ["**IV**", "**Confused-Agitated:** Patient is in a heightened state of activity. Behavior is bizarre and non-purposeful relative to the immediate environment. Unable to cooperate directly with treatment efforts. Verbalizations are frequently incoherent and/or inappropriate."], isHeader: false)
        let assessment7Row2_6 = TableRow(cells: ["**V**", "**Confused-Inappropriate, Non-Agitated:** Patient is able to respond to simple commands fairly consistently. However, with increased complexity of commands or lack of external structure, responses are non-purposeful, random, or fragmented. Attention is highly distractible."], isHeader: false)
        let assessment7Row2_7 = TableRow(cells: ["**VI**", "**Confused-Appropriate:** Patient shows goal-directed behavior but is dependent on external input for direction. Follows simple directions consistently and shows carryover for relearned tasks such as self-care."], isHeader: false)
        let assessment7Row2_8 = TableRow(cells: ["**VII**", "**Automatic-Appropriate:** Patient appears appropriate and oriented within hospital and home settings; goes through daily routine automatically, but frequently robot-like. Shows minimal to no confusion and has shallow recall of activities. Judgment remains impaired."], isHeader: false)
        let assessment7Row2_9 = TableRow(cells: ["**VIII**", "**Purposeful-Appropriate:** Patient is able to recall and integrate past and recent events and is aware of and responsive to their environment. Shows carryover for new learning and needs no supervision once activities are learned."], isHeader: false)
        let assessment7Section2 = ContentSection(
            title: "Detailed Scoring and Interpretation",
            content: "",
            displayType: .table,
            tableData: [assessment7Row2_0, assessment7Row2_1, assessment7Row2_2, assessment7Row2_3, assessment7Row2_4, assessment7Row2_5, assessment7Row2_6, assessment7Row2_7, assessment7Row2_8, assessment7Row2_9],
            orderIndex: 2
        )
        assessment7.sections.append(assessment7Section2)

        let assessment7Section3 = ContentSection(
            title: "Clinical Pearls, Contraindications, or Pitfalls",
            content: "• Not a Prognostic Tool: The LCFS describes current cognitive and behavioral status; it does not predict the rate or limit of recovery.\\n• Fluidity: Patients may progress through the levels at different rates and may plateau at any level.\\n• Guiding Interventions: The scale is invaluable for guiding the rehabilitation team's approach. For example, a patient at Level IV requires a low-stimulation environment and behavioral management, whereas a patient at Level VII benefits from community reintegration activities.",
            displayType: .list,
            orderIndex: 3
        )
        assessment7.sections.append(assessment7Section3)

        let assessment7Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Applicable in Guides: Disorders of Consciousness (DOC) after TBI, Agitation and Aggression after TBI, Post-Traumatic Headache (PTH), Post-Traumatic Seizures and Epilepsy (PTE).",
            displayType: .list,
            orderIndex: 4
        )
        assessment7.sections.append(assessment7Section4)

        let assessment7Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        assessment7.sections.append(assessment7Section5)
        context.insert(assessment7)

        let assessment8 = MedicalContent(
            title: "Principles of Electrodiagnostic Studies (NCS/EMG)",
            subtitle: nil,
            contentType: .assessment,
            category: "Assessment Tools",
            overview: "",
            keywords: []
        )

        let assessment8Section0 = ContentSection(
            title: "Purpose and Clinical Indication",
            content: "Electrodiagnostic studies, which include Nerve Conduction Studies (NCS) and Needle Electromyography (EMG), are an extension of the neurological physical examination. They are used to evaluate the function and integrity of the peripheral nervous system, including nerve roots, plexuses, peripheral nerves, the neuromuscular junction, and muscles. These tests are indicated when a patient presents with symptoms such as weakness, numbness, tingling, or pain that suggest a neuromuscular disorder. They help to localize a lesion, determine its severity, differentiate between nerve (neuropathic) and muscle (myopathic) problems, and distinguish between different types of nerve injury (axonal vs. demyelinating).",
            displayType: .text,
            orderIndex: 0
        )
        assessment8.sections.append(assessment8Section0)

        let assessment8Section1 = ContentSection(
            title: "Step-by-Step Description of Assessment",
