        let guide7Row1_2 = TableRow(cells: ["I", "m", "a", "g", "i", "n", "g", ":", " ", "I", "m", "a", "g", "i", "n", "g", " ", "i", "s", " ", "u", "s", "e", "d", " ", "t", "o", " ", "r", "u", "l", "e", " ", "o", "u", "t", " ", "m", "o", "r", "e", " ", "s", "i", "n", "i", "s", "t", "e", "r", " ", "i", "n", "t", "r", "a", "c", "r", "a", "n", "i", "a", "l", " ", "p", "a", "t", "h", "o", "l", "o", "g", "y", ",", " ", "n", "o", "t", " ", "t", "o", " ", "d", "i", "a", "g", "n", "o", "s", "e", " ", "P", "T", "H", " ", "i", "t", "s", "e", "l", "f", "."], isHeader: false)
        let guide7Row1_3 = TableRow(cells: ["A", "c", "u", "t", "e", " ", "S", "e", "t", "t", "i", "n", "g", ":", " ", "A", " ", "n", "o", "n", "-", "c", "o", "n", "t", "r", "a", "s", "t", " ", "h", "e", "a", "d", " ", "C", "T", " ", "i", "s", " ", "t", "h", "e", " ", "s", "t", "a", "n", "d", "a", "r", "d", " ", "o", "f", " ", "c", "a", "r", "e", " ", "t", "o", " ", "r", "u", "l", "e", " ", "o", "u", "t", " ", "a", "c", "u", "t", "e", " ", "i", "n", "t", "r", "a", "c", "r", "a", "n", "i", "a", "l", " ", "h", "e", "m", "o", "r", "r", "h", "a", "g", "e", ",", " ", "s", "k", "u", "l", "l", " ", "f", "r", "a", "c", "t", "u", "r", "e", ",", " ", "o", "r", " ", "o", "t", "h", "e", "r", " ", "l", "e", "s", "i", "o", "n", "s", " ", "r", "e", "q", "u", "i", "r", "i", "n", "g", " ", "u", "r", "g", "e", "n", "t", " ", "n", "e", "u", "r", "o", "s", "u", "r", "g", "i", "c", "a", "l", " ", "i", "n", "t", "e", "r", "v", "e", "n", "t", "i", "o", "n", ".", " ", "T", "h", "e", " ", "C", "a", "n", "a", "d", "i", "a", "n", " ", "C", "T", " ", "H", "e", "a", "d", " ", "R", "u", "l", "e", " ", "c", "a", "n", " ", "g", "u", "i", "d", "e", " ", "i", "t", "s", " ", "u", "s", "e", " ", "i", "n", " ", "m", "i", "n", "o", "r", " ", "T", "B", "I", "."], isHeader: false)
        let guide7Row1_4 = TableRow(cells: ["S", "u", "b", "a", "c", "u", "t", "e", "/", "C", "h", "r", "o", "n", "i", "c", " ", "S", "e", "t", "t", "i", "n", "g", ":", " ", "A", " ", "b", "r", "a", "i", "n", " ", "M", "R", "I", " ", "i", "s", " ", "t", "h", "e", " ", "p", "r", "e", "f", "e", "r", "r", "e", "d", " ", "m", "o", "d", "a", "l", "i", "t", "y", " ", "i", "f", " ", "h", "e", "a", "d", "a", "c", "h", "e", "s", " ", "a", "r", "e", " ", "p", "e", "r", "s", "i", "s", "t", "e", "n", "t", ",", " ", "w", "o", "r", "s", "e", "n", "i", "n", "g", ",", " ", "o", "r", " ", "a", "s", "s", "o", "c", "i", "a", "t", "e", "d", " ", "w", "i", "t", "h", " ", "n", "e", "w", " ", "n", "e", "u", "r", "o", "l", "o", "g", "i", "c", "a", "l", " ", "d", "e", "f", "i", "c", "i", "t", "s", ".", " ", "I", "t", " ", "i", "s", " ", "m", "o", "r", "e", " ", "s", "e", "n", "s", "i", "t", "i", "v", "e", " ", "t", "h", "a", "n", " ", "C", "T", " ", "f", "o", "r", " ", "d", "e", "t", "e", "c", "t", "i", "n", "g", " ", "s", "u", "b", "t", "l", "e", " ", "f", "i", "n", "d", "i", "n", "g", "s", " ", "l", "i", "k", "e", " ", "d", "i", "f", "f", "u", "s", "e", " ", "a", "x", "o", "n", "a", "l", " ", "i", "n", "j", "u", "r", "y", ",", " ", "m", "i", "c", "r", "o", "h", "e", "m", "o", "r", "r", "h", "a", "g", "e", "s", ",", " ", "o", "r", " ", "c", "o", "n", "t", "u", "s", "i", "o", "n", "s", "."], isHeader: false)
        let guide7Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Classification Systems",
            content: "",
            displayType: .scale,
            tableData: [guide7Row1_0, guide7Row1_1, guide7Row1_2, guide7Row1_3, guide7Row1_4],
            orderIndex: 1
        )
        guide7.sections.append(guide7Section1)

        let guide7Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Non-Pharmacologic Management:**\\n• Patient Education and Lifestyle Modification:: This is the foundation of management. It includes education about the expected course of recovery, reassurance, and strategies for managing triggers. Key lifestyle modifications include maintaining regular sleep-wake cycles, ensuring adequate hydration, engaging in regular aerobic exercise, and avoiding caffeine.\\n• Therapies:: Physical therapy is crucial for addressing any cervicogenic components or neck pain. Other effective non-drug treatments include cognitive-behavioral therapy (CBT), biofeedback, and relaxation therapy.\\n• **Pharmacologic Management (Abortive/Acute Treatment):**\\n• The goal is to relieve individual headache attacks. A critical teaching point is the prevention of **Medication Overuse Headache (MOH)**. The use of any acute medication should be limited to 2-3 days per week (a maximum of 10-15 days per month, depending on the agent).\\n• First-line:: Simple analgesics like high-dose acetaminophen (1000 mg) and NSAIDs (e.g., ibuprofen 400 mg, naproxen) are effective.\\n• Migraine-Specific Agents:: For moderate-to-severe migraine-like attacks, triptans (e.g., sumatriptan, rizatriptan) are a mainstay. Newer agents like CGRP-receptor antagonists (gepants) and serotonin 5-HT1F receptor agonists (ditans) are also options.\\n• **Pharmacologic Management (Preventive/Prophylactic Treatment):**\\n• Preventive therapy should be considered when headaches are frequent (e.g., \\>4 headache days per month or \\>10 per month depending on guidelines), severe, or significantly impact function.\\n• For Migraine-like PTH:: Evidence-based options include beta-blockers (propranolol), antidepressants (amitriptyline, venlafaxine), and anticonvulsants (topiramate, valproate). Topiramate should be used with caution in TBI patients due to potential cognitive side effects. Monoclonal antibodies targeting the CGRP pathway (e.g., erenumab, fremanezumab, galcanezumab) are highly effective and well-tolerated options.\\n• For Tension-type PTH:: Amitriptyline is the preventive medication with the best evidence.\\n• **Interventional Procedures:**\\n• Nerve Blocks:: For headaches with a clear peripheral nerve component, injections can be both diagnostic and therapeutic. A greater occipital nerve block is effective for occipital neuralgia and cervicogenic headache. Supraorbital or supratrochlear nerve blocks can also be considered.\\n• Trigger Point Injections:: For myofascial pain components in the cervical or pericranial musculature.\\n• OnabotulinumtoxinA (Botox):: FDA-approved for the prevention of chronic migraine and can be an effective treatment for persistent PTH that meets chronic migraine criteria.\\n• Nerve Decompression Surgery:: In rare, refractory cases where a specific peripheral nerve entrapment is identified as the pain generator, surgical release may be an option.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide7.sections.append(guide7Section2)

        let guide7Section3 = ContentSection(
            title: "Common Complications and Prognosis",
            content: "• Prognosis: While most acute PTH resolves within three months, a substantial percentage of individuals (reported as 18-65% in various studies) develop persistent post-traumatic headache, which can last for months or years and significantly lower quality of life.\\n• Post-Concussive Syndrome (PCS): PTH is a cardinal symptom of PCS, a constellation of symptoms that can persist after TBI, including dizziness, fatigue, irritability, insomnia, anxiety, and cognitive difficulties (e.g., poor concentration, memory problems). Management of PTH must occur in the context of managing these other associated symptoms.\\n• Psychiatric Comorbidity: There is a strong bidirectional relationship between PTH and psychiatric conditions, particularly depression, anxiety, and post-traumatic stress disorder (PTSD). The presence of these conditions can worsen headache outcomes, and persistent pain can exacerbate psychiatric symptoms, creating a vicious cycle.",
            displayType: .list,
            orderIndex: 3
        )
        guide7.sections.append(guide7Section3)

        let guide7Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Mild TBI & Post-Concussion Syndrome, Agitation and Behavioral Management after TBI, Spasticity Management in Brain Injury.\\n• Referenced Assessment Tools: Rancho Los Amigos Scale (LCFS).",
            displayType: .list,
            orderIndex: 4
        )
        guide7.sections.append(guide7Section4)

        let guide7Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide7.sections.append(guide7Section5)
        context.insert(guide7)

        let guide8 = MedicalContent(
            title: "Post-Traumatic Seizures and Epilepsy (PTE)",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide8Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Post-traumatic seizures are a significant complication of TBI. A distinction is made between seizures that occur early after the injury and those that develop later.  \n\n Early Post-Traumatic Seizures (PTS): These are seizures that occur within the first 7 days following a TBI. They are considered an acute, provoked symptom resulting directly from the initial brain insult and its immediate aftermath (e.g., hemorrhage, edema, metabolic derangement).    \n Late Post-Traumatic Seizures / Post-Traumatic Epilepsy (PTE): PTE is defined as the occurrence of two or more unprovoked seizures more than one week after the TBI. A single unprovoked seizure after this period is termed a late PTS. PTE represents an enduring predisposition to seizures due to permanent, pathological changes in neural circuits—a process known as epileptogenesis.  \n\nThe pathophysiology of PTE involves a complex cascade of events following the initial injury. TBI leads to neuronal cell loss, inflammation, and breakdown of the blood-brain barrier. This triggers long-term changes in neural networks, including axonal sprouting and synaptic reorganization, particularly in the hippocampus and neocortex. A key mechanism is an imbalance between excitatory and inhibitory neurotransmission. Excess extracellular glutamate from injured cells leads to excitotoxicity, while the function of inhibitory GABAergic neurons may be impaired. This creates a hyperexcitable state in the brain, lowering the seizure threshold and leading to the spontaneous, recurrent seizures that define epilepsy.  \n\nThe clinical presentation of a seizure can vary widely but may include motor symptoms (stiffening or shaking of the body), staring and unresponsiveness, confusion, or strange sensory experiences.",
            displayType: .text,
            orderIndex: 0
        )
        guide8.sections.append(guide8Section0)

        let guide8Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• History:: A detailed history of the TBI (including severity) and a clear description of the seizure events are crucial.\\n• Electroencephalogram (EEG):: An EEG is performed to detect abnormal electrical activity in the brain and can help confirm the diagnosis and classify the seizure type.\\n• Neuroimaging:: A brain MRI is the preferred imaging modality. It can identify structural abnormalities related to the initial trauma, such as areas of encephalomalacia, gliosis, or hemosiderin deposition, which can be epileptogenic foci.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide8.sections.append(guide8Section1)

        let guide8Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Pharmacologic Management:**\\n• Prophylaxis for Early PTS:: Antiepileptic drugs (AEDs) such as phenytoin or levetiracetam are effective at preventing seizures during the first 7 days after a moderate to severe TBI and are recommended for this period.\\n• Treatment of PTE:: Once PTE is established (i.e., after a late unprovoked seizure), long-term treatment with an AED is initiated. The choice of medication depends on the seizure type, side effect profile, and patient comorbidities.\\n• Important Note:: Prophylactic use of AEDs beyond the first week has *not* been shown to prevent the development of PTE. They treat the symptom (seizures) but do not alter the underlying process of epileptogenesis.\\n• Surgical Management:: For patients with drug-resistant focal epilepsy, surgical options may be considered after a comprehensive evaluation at a specialized epilepsy center.\\n• Resective Surgery:: Involves removing the area of the brain where seizures originate.\\n• Neurostimulation:: Devices such as a Vagus Nerve Stimulator (VNS), Responsive Neurostimulation (RNS), or Deep Brain Stimulation (DBS) can be implanted to help modulate brain activity and reduce seizure frequency.\\n• Patient and Family Education:: Education is critical for safety and management. This includes:\\n• Seizure Precautions:: Counseling on avoiding potential triggers and ensuring safety during a seizure (e.g., driving restrictions, swimming safety).\\n• Medication Adherence:: Emphasizing the importance of consistently taking AEDs.\\n• Prevention:: The best way to prevent PTE is to prevent the initial TBI through measures like wearing helmets and using seatbelts.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide8.sections.append(guide8Section2)

        let guide8Section3 = ContentSection(
            title: "Prognosis",
            content: "Approximately 80% of PTE cases develop within the first two years after injury. While PTE can be a lifelong condition, some studies suggest that about half of patients with late PTE may eventually experience spontaneous remission.",
            displayType: .text,
            orderIndex: 3
        )
        guide8.sections.append(guide8Section3)

        let guide8Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Disorders of Consciousness (DOC) after TBI.\\n• Referenced Assessment Tools: Glasgow Coma Scale (GCS), Rancho Los Amigos Scale (LCFS).",
            displayType: .list,
            orderIndex: 4
        )
        guide8.sections.append(guide8Section4)

        let guide8Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide8.sections.append(guide8Section5)
        context.insert(guide8)

        let guide9 = MedicalContent(
            title: "Neuroendocrine Dysfunction after TBI",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide9Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Neuroendocrine dysfunction, or post-traumatic hypopituitarism (PTHP), is an increasingly recognized but often underdiagnosed complication of TBI. It results from damage to the hypothalamus and/or pituitary gland, which are highly vulnerable to traumatic forces due to their location and delicate vascular supply. The injury can disrupt the production and regulation of one or multiple hormones, leading to a wide range of clinical manifestations.  \n\nThe pathophysiology can involve direct mechanical damage (e.g., from shear forces or skull base fractures), ischemic injury to the pituitary stalk or gland, or secondary cytotoxic processes. The anterior pituitary is more commonly affected, with growth hormone (GH) and gonadotropins (LH, FSH) being the most frequent deficiencies, likely due to the anatomical location of the cells that produce them.  \n\nThe clinical presentation of PTHP is often subtle and non-specific, with symptoms that significantly overlap with those of post-concussive syndrome, depression, and chronic fatigue. This makes diagnosis challenging, as symptoms may be mistakenly attributed to the brain injury itself. Key symptoms associated with specific hormone deficiencies include:  \n\n Growth Hormone (GH) Deficiency: Fatigue, decreased muscle mass, increased abdominal fat, impaired concentration and memory, and reduced quality of life. This is one of the most common deficiencies.    \n Hypogonadism (LH/FSH Deficiency):  \n   In Men: Decreased libido, erectile dysfunction, fatigue, decreased muscle mass, infertility, and mood changes.    \n   In Women: Menstrual irregularities (oligomenorrhea/amenorrhea), infertility, and sexual dysfunction.    \n Adrenal Insufficiency (ACTH Deficiency): Fatigue, weakness, weight loss, hypotension, and inability to mount an appropriate stress response. Acute adrenal crisis can be life-threatening.  \n Central Hypothyroidism (TSH Deficiency): Fatigue, weight gain, cold intolerance, and cognitive slowing.    \n* Posterior Pituitary Dysfunction: This is less common in the chronic phase but can present acutely as diabetes insipidus (DI) with polyuria and polydipsia, or syndrome of inappropriate antidiuretic hormone (SIADH).",
            displayType: .text,
            orderIndex: 0
        )
        guide9.sections.append(guide9Section0)

        let guide9Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• History and Physical:: A thorough history focusing on the symptoms listed above is essential.\\n• Laboratory Screening:: Initial screening involves a morning blood draw to measure baseline levels of key hormones:\\n• IGF-1:: A screening test for GH deficiency. A low level is suggestive, but a normal level does not rule it out.\\n• **Testosterone (total and free) with LH and FSH (in men).**\\n• **Estradiol with LH and FSH (in women, timed with menstrual cycle if applicable).**\\n• **Morning Cortisol and ACTH.**\\n• **Free T4 and TSH.**\\n• **Prolactin.**\\n• Confirmatory and Dynamic Testing:: If screening tests are abnormal or suspicion remains high, referral to an endocrinologist is warranted for definitive dynamic stimulation testing (e.g., insulin tolerance test for GH/ACTH, GnRH stimulation test for gonadotropins).",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide9.sections.append(guide9Section1)

        let guide9Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Growth Hormone Replacement:: Administered via daily subcutaneous injections.\\n• Testosterone Replacement:: Can be given via injections, gels, or patches for men with hypogonadism.\\n• Estrogen/Progesterone Replacement:: For premenopausal women with hypogonadism.\\n• Hydrocortisone Replacement:: For adrenal insufficiency. This is critical, and patients require education on \"stress dosing\" during illness or surgery.\\n• Levothyroxine Replacement:: For central hypothyroidism.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide9.sections.append(guide9Section2)

        let guide9Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• The primary complication is a missed diagnosis, leading to persistent symptoms that impair recovery and quality of life.\\n• Undiagnosed adrenal insufficiency can lead to a life-threatening adrenal crisis.\\n• Long-term, untreated hypopituitarism can contribute to poor cardiovascular health, osteoporosis, and decreased longevity.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide9.sections.append(guide9Section3)

        let guide9Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Post-Traumatic Headache (PTH).\\n• Referenced Assessment Tools: Rancho Los Amigos Scale (LCFS).",
            displayType: .list,
            orderIndex: 4
        )
        guide9.sections.append(guide9Section4)

        let guide9Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide9.sections.append(guide9Section5)
        context.insert(guide9)

        let guide10 = MedicalContent(
            title: "Post-Stroke Spasticity (PSS)",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide10Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Post-stroke spasticity (PSS) is a motor disorder, defined as a velocity-dependent increase in tonic stretch reflexes (muscle tone) with exaggerated tendon jerks, resulting from hyperexcitability of the stretch reflex. It is a common and often disabling complication, affecting approximately 25% to 43% of stroke survivors within the first year. While its onset can vary, it typically emerges within 1 to 6 weeks post-stroke and peaks around 3 months.  \n\nThe pathophysiology of PSS is rooted in the disruption of descending motor pathways from the brain. The upper motor neuron lesion caused by the stroke leads to an imbalance between excitatory and inhibitory signals reaching the spinal cord. Specifically, damage to inhibitory pathways, such as the corticoreticular tract, results in the disinhibition and subsequent hyperexcitability of spinal reflex arcs and alpha motor neurons. This is not solely a neural phenomenon; over time, secondary changes occur within the muscle itself, including alterations in mechanical properties, shortening of muscle fibers, and an increase in connective tissue, which contribute to the stiffness and resistance to stretch.  \n\nThe clinical presentation is characterized by increased muscle tone that is dependent on the speed of movement—the faster a limb is passively stretched, the greater the resistance encountered. PSS preferentially affects antigravity muscles, leading to predictable patterns and postures:  \n\n Upper Limb: Adducted and internally rotated shoulder, flexed elbow, pronated forearm, and a clenched fist with a flexed wrist and fingers.    \n Lower Limb: Adducted hip, extended knee, and a plantarflexed and inverted foot (equinovarus), which can lead to a \"scissoring\" gait pattern.    \n* Other associated signs include clonus (rhythmic, involuntary muscle contractions), painful muscle spasms, and the \"clasp-knife\" phenomenon, where initial high resistance to passive movement suddenly gives way. If left unmanaged, PSS can lead to the development of fixed joint contractures.",
            displayType: .text,
            orderIndex: 0
        )
        guide10.sections.append(guide10Section0)

        let guide10Row1_0 = TableRow(cells: ["M", "o", "d", "i", "f", "i", "e", "d", " ", "A", "s", "h", "w", "o", "r", "t", "h", " ", "S", "c", "a", "l", "e", " ", "(", "M", "A", "S", ")", ":", " ", "T", "h", "i", "s", " ", "i", "s", " ", "t", "h", "e", " ", "m", "o", "s", "t", " ", "c", "o", "m", "m", "o", "n", "l", "y", " ", "u", "s", "e", "d", " ", "s", "c", "a", "l", "e", " ", "i", "n", " ", "c", "l", "i", "n", "i", "c", "a", "l", " ", "p", "r", "a", "c", "t", "i", "c", "e", ".", " ", "I", "t", " ", "g", "r", "a", "d", "e", "s", " ", "r", "e", "s", "i", "s", "t", "a", "n", "c", "e", " ", "t", "o", " ", "p", "a", "s", "s", "i", "v", "e", " ", "m", "o", "v", "e", "m", "e", "n", "t", " ", "o", "n", " ", "a", " ", "0", "-", "4", " ", "s", "c", "a", "l", "e", ".", " ", "W", "h", "i", "l", "e", " ", "q", "u", "i", "c", "k", " ", "a", "n", "d", " ", "e", "a", "s", "y", " ", "t", "o", " ", "u", "s", "e", ",", " ", "i", "t", " ", "i", "s", " ", "a", " ", "s", "u", "b", "j", "e", "c", "t", "i", "v", "e", " ", "m", "e", "a", "s", "u", "r", "e", " ", "w", "i", "t", "h", " ", "o", "n", "l", "y", " ", "p", "o", "o", "r", "-", "t", "o", "-", "m", "o", "d", "e", "r", "a", "t", "e", " ", "r", "e", "l", "i", "a", "b", "i", "l", "i", "t", "y", " ", "a", "n", "d", " ", "d", "o", "e", "s", " ", "n", "o", "t", " ", "d", "i", "s", "t", "i", "n", "g", "u", "i", "s", "h", " ", "s", "p", "a", "s", "t", "i", "c", "i", "t", "y", " ", "f", "r", "o", "m", " ", "c", "o", "n", "t", "r", "a", "c", "t", "u", "r", "e", "."], isHeader: true)
        let guide10Row1_1 = TableRow(cells: ["T", "a", "r", "d", "i", "e", "u", " ", "S", "c", "a", "l", "e", ":", " ", "T", "h", "i", "s", " ", "s", "c", "a", "l", "e", " ", "i", "s", " ", "c", "o", "n", "s", "i", "d", "e", "r", "e", "d", " ", "m", "o", "r", "e", " ", "v", "a", "l", "i", "d", " ", "a", "s", " ", "i", "t", " ", "d", "i", "r", "e", "c", "t", "l", "y", " ", "a", "s", "s", "e", "s", "s", "e", "s", " ", "v", "e", "l", "o", "c", "i", "t", "y", "-", "d", "e", "p", "e", "n", "d", "e", "n", "c", "e", ".", " ", "I", "t", " ", "m", "e", "a", "s", "u", "r", "e", "s", " ", "t", "h", "e", " ", "m", "u", "s", "c", "l", "e", "'", "s", " ", "r", "e", "a", "c", "t", "i", "o", "n", " ", "t", "o", " ", "p", "a", "s", "s", "i", "v", "e", " ", "s", "t", "r", "e", "t", "c", "h", " ", "a", "t", " ", "t", "h", "r", "e", "e", " ", "d", "i", "f", "f", "e", "r", "e", "n", "t", " ", "s", "p", "e", "e", "d", "s", " ", "(", "V", "1", ",", " ", "V", "2", ",", " ", "V", "3", ")", ".", " ", "I", "t", " ", "q", "u", "a", "n", "t", "i", "f", "i", "e", "s", " ", "t", "w", "o", " ", "a", "n", "g", "l", "e", "s", ":", " ", "R", "2", " ", "(", "t", "h", "e", " ", "f", "u", "l", "l", " ", "p", "a", "s", "s", "i", "v", "e", " ", "r", "a", "n", "g", "e", " ", "o", "f", " ", "m", "o", "t", "i", "o", "n", " ", "a", "t", " ", "s", "l", "o", "w", " ", "s", "p", "e", "e", "d", ")", " ", "a", "n", "d", " ", "R", "1", " ", "(", "t", "h", "e", " ", "a", "n", "g", "l", "e", " ", "o", "f", " ", "\"", "c", "a", "t", "c", "h", "\"", " ", "a", "t", " ", "f", "a", "s", "t", " ", "s", "p", "e", "e", "d", ")", ".", " ", "T", "h", "e", " ", "d", "i", "f", "f", "e", "r", "e", "n", "c", "e", " ", "(", "R", "2", "-", "R", "1", ")", " ", "r", "e", "p", "r", "e", "s", "e", "n", "t", "s", " ", "t", "h", "e", " ", "d", "y", "n", "a", "m", "i", "c", ",", " ", "s", "p", "a", "s", "t", "i", "c", " ", "c", "o", "m", "p", "o", "n", "e", "n", "t", ",", " ", "w", "h", "i", "l", "e", " ", "a", " ", "s", "m", "a", "l", "l", " ", "R", "2", " ", "a", "n", "g", "l", "e", " ", "i", "n", "d", "i", "c", "a", "t", "e", "s", " ", "a", " ", "f", "i", "x", "e", "d", " ", "c", "o", "n", "t", "r", "a", "c", "t", "u", "r", "e", "."], isHeader: false)
        let guide10Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Classification Systems",
            content: "",
            displayType: .scale,
            tableData: [guide10Row1_0, guide10Row1_1],
            orderIndex: 1
        )
        guide10.sections.append(guide10Section1)

        let guide10Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Physical and Occupational Therapy:**\\n• Stretching and Positioning:: Daily passive and active-assisted range of motion exercises are fundamental to maintain muscle length, preserve joint mobility, and prevent the formation of contractures.\\n• Strengthening:: It is a misconception that strengthening spastic muscles worsens spasticity. Evidence shows that strength training of both the spastic (agonist) and opposing (antagonist) muscles can improve motor function and does not increase spasticity.\\n• Splinting and Casting:: While routine use of static splints is not recommended for spasticity reduction, they can be used to maintain range of motion or improve function. Serial casting is an effective technique to progressively stretch and lengthen a shortened, spastic muscle to treat an early contracture.\\n• Other Modalities:: Adjunctive therapies such as neuromuscular electrical stimulation (NMES), vibration therapy, and extracorporeal shock wave therapy (ESWT) may be used to temporarily reduce tone and facilitate active movement.\\n• **Pharmacologic Management:**\\n• Oral Antispasmodics:: Medications such as baclofen, tizanidine, and diazepam are used to treat generalized or multi-limb spasticity. Their utility is often limited by systemic side effects, most notably sedation, dizziness, and generalized weakness, which can interfere with rehabilitation participation.\\n• Intrathecal Baclofen (ITB) Therapy:: For severe, disabling generalized spasticity that is refractory to oral agents, an ITB pump can be surgically implanted. This device delivers baclofen directly into the cerebrospinal fluid, allowing for a potent anti-spasticity effect at a fraction of the oral dose, thereby minimizing systemic side effects.\\n• **Interventional Procedures for Focal Spasticity:**\\n• Botulinum Toxin A (BoNT-A) Injections:: This is the established first-line treatment for focal spasticity that affects a limited number of muscles (e.g., a clenched fist, equinovarus foot). The toxin works by blocking the release of acetylcholine at the neuromuscular junction, causing temporary muscle paralysis. Injections are typically guided by ultrasound or EMG and must be followed by a dedicated therapy program (stretching, casting, strengthening) to maximize the functional benefit during the 3-4 month period of effect.\\n• Chemodenervation with Phenol/Alcohol:: Nerve blocks with these neurolytic agents can be used to target specific motor nerves. They provide a longer-lasting effect than BoNT-A but are technically more demanding and carry a risk of dysesthetic pain if sensory fibers are affected.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide10.sections.append(guide10Section2)

        let guide10Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Contracture:: This is the most significant complication, where the muscle and surrounding soft tissues become permanently shortened, leading to a fixed, non-reducible joint deformity. Prevention through consistent range of motion is key. Once established, management may require serial casting or surgical release.\\n• Pain:: Spasticity can be inherently painful due to intense muscle spasms or can cause pain secondary to abnormal joint postures and mechanics.\\n• Skin Breakdown:: Severe spasticity, such as a tightly clenched fist or adducted thighs, can make hygiene difficult and lead to skin maceration, fungal infections, and pressure injuries.\\n• Impaired Function:: Spasticity can severely interfere with gait, balance, transfers, dressing, and other ADLs. It can also prevent the effective use of orthoses.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide10.sections.append(guide10Section3)

        let guide10Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Post-Stroke Motor Recovery and Gait Impairment, Post-Stroke Aphasia and Dysphagia.\\n• Referenced Assessment Tools: Modified Ashworth Scale (MAS), Tardieu Scale, Functional Independence Measure (FIM).",
            displayType: .list,
            orderIndex: 4
        )
        guide10.sections.append(guide10Section4)

        let guide10Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide10.sections.append(guide10Section5)
        context.insert(guide10)

        let guide11 = MedicalContent(
            title: "Post-Stroke Motor Recovery and Gait Impairment",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide11Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Motor impairment, particularly weakness (hemiparesis) and impaired gait, is one of the most common and disabling consequences of stroke. More than 80% of stroke survivors experience some degree of gait impairment. Recovery of motor function is driven by  \n\nneuroplasticity, the brain's ability to reorganize itself by forming new neural connections to compensate for the damaged areas. However, this process is often incomplete, leading to persistent functional deficits.  \n\nThe clinical presentation of post-stroke gait impairment is often characterized by:\n\n Hemiparetic Gait: A typical pattern involving weakness on one side of the body, leading to decreased walking speed, poor endurance, and asymmetry.  \n Spasticity: Increased muscle tone can lead to abnormal limb posturing, such as an equinovarus foot (plantarflexed and inverted) or a stiff-knee gait, which further impedes efficient walking.  \n Impaired Balance: Difficulty with postural control increases the risk of falls.    \n Decreased Walking Speed and Endurance: These are key indicators of functional limitation and are strongly correlated with a person's ability to ambulate in the community.",
            displayType: .text,
            orderIndex: 0
        )
        guide11.sections.append(guide11Section0)

        let guide11Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• Manual Muscle Testing (MMT):: To quantify the degree of paresis in specific muscle groups.\\n• Range of Motion Assessment:: To identify limitations from spasticity or contracture.\\n• Functional Gait Assessment:: Standardized tools are used to quantify gait parameters and track progress.\\n• 10-Meter Walk Test:: Measures walking speed (gait velocity).\\n• 6-Minute Walk Test:: Measures walking endurance and cardiovascular fitness.\\n• Timed Up and Go (TUG) Test:: Assesses dynamic balance and mobility.\\n• Observational Gait Analysis:: A skilled clinician observes the patient walking to identify specific biomechanical deviations at each phase of the gait cycle.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide11.sections.append(guide11Section1)

        let guide11Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• High-Intensity Gait Training:: Evidence strongly supports that a higher dose and intensity of practice leads to better outcomes. Rehabilitation programs should aim for a high number of repetitions (steps) per session and an intensity that challenges the patient's cardiorespiratory system (e.g., \\>70% of peak heart rate).\\n• **Treadmill Training:**\\n• With or Without Body-Weight Support (BWS):: Treadmill training allows for controlled, repetitive practice of a normal walking pattern. BWS systems can be used to enable patients who are severely weak to begin gait training earlier and more safely.\\n• Robotic-Assisted Gait Training:: Robotic exoskeletons can be used in conjunction with a treadmill to assist with leg movements, allowing for a high volume of practice. This can be particularly useful for patients with severe impairments.\\n• Functional Electrical Stimulation (FES):: FES can be used as an adjunct to gait training. Electrodes are placed over paretic muscles (e.g., the ankle dorsiflexors to correct foot drop) and are timed to stimulate the muscle to contract during the appropriate phase of the gait cycle. This can improve gait kinematics and speed.\\n• Strength Training:: Progressive resistance training of both paretic and non-paretic muscles is safe and effective for improving strength and function after stroke. It is a misconception that strengthening spastic muscles makes spasticity worse.\\n• Task-Specific Training:: Practice should be focused on real-world tasks, such as walking over varied surfaces, climbing stairs, and navigating obstacles to improve community ambulation.\\n• Cardiorespiratory Fitness Training:: Improving cardiovascular fitness through aerobic exercise (e.g., stationary cycling, arm ergometry) is a critical component of rehabilitation, as many stroke survivors are deconditioned.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide11.sections.append(guide11Section2)

        let guide11Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Falls:: Impaired gait and balance place stroke survivors at a high risk of falls. Management includes balance training, appropriate use of assistive devices (canes, walkers), and home safety modifications.\\n• Contractures:: Can develop due to prolonged immobility and unmanaged spasticity. Prevented with regular range of motion exercises and proper positioning.\\n• Cardiovascular Deconditioning:: Can limit participation in therapy and increase the risk of future cardiovascular events. Addressed with a structured exercise program.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide11.sections.append(guide11Section3)

        let guide11Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Post-Stroke Spasticity (PSS).\\n• Referenced Assessment Tools: 10-Meter Walk Test, 6-Minute Walk Test, Timed Up and Go (TUG) Test, Functional Independence Measure (FIM).",
            displayType: .list,
            orderIndex: 4
        )
        guide11.sections.append(guide11Section4)

        let guide11Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide11.sections.append(guide11Section5)
        context.insert(guide11)

        let guide12 = MedicalContent(
            title: "Post-Stroke Dysphagia",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide12Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Dysphagia, or difficulty swallowing, is a common and serious complication following a stroke, affecting a large percentage of patients in the acute phase. It arises from damage to the cortical and subcortical areas of the brain that control the complex sequence of muscle movements required for a safe and efficient swallow. This can lead to impairment in the oral phase (e.g., difficulty chewing or forming a bolus) or the pharyngeal phase (e.g., delayed swallow trigger, reduced airway protection).  \n\nThe primary clinical concern with dysphagia is aspiration, which is the entry of food, liquid, or saliva into the airway below the level of the vocal cords. Aspiration can lead to aspiration pneumonia, a life-threatening infection. Clinical signs suggestive of dysphagia include:  \n\n Coughing or choking during or after eating or drinking  \n A wet or \"gurgly\" voice quality after swallowing  \n Difficulty initiating a swallow  \n Food or liquid leaking from the mouth  \n Sensation of food getting stuck in the throat  \n Recurrent pneumonia or unexplained fevers",
            displayType: .text,
            orderIndex: 0
        )
        guide12.sections.append(guide12Section0)

        let guide12Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• Swallowing Screen:: All stroke patients should be screened for dysphagia by a trained professional (often a nurse) before any oral intake is permitted. Simple screens like the 3-ounce water swallow test are used to identify patients at high risk for aspiration. A failed screen mandates that the patient remain NPO (nothing by mouth) and triggers a formal evaluation.\\n• Clinical Swallowing Evaluation:: This is a comprehensive bedside assessment performed by a Speech-Language Pathologist (SLP). It includes a thorough oral motor and cranial nerve examination and observation of the patient swallowing small amounts of various food and liquid consistencies.\\n• Instrumental Assessment:: This is the gold standard for visualizing the swallow and definitively diagnosing aspiration. It is indicated for patients who are at high risk based on the clinical evaluation.\\n• Videofluoroscopic Swallow Study (VFSS) or Modified Barium Swallow (MBS):: A video X-ray taken while the patient swallows food and liquid mixed with barium. It allows for detailed analysis of the oral and pharyngeal phases of swallowing.\\n• Fiberoptic Endoscopic Evaluation of Swallowing (FEES):: A flexible endoscope is passed through the nose to the pharynx to directly visualize the larynx and pharynx before and after the swallow.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide12.sections.append(guide12Section1)

        let guide12Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Compensatory Strategies:: These are used to reduce the risk of aspiration and improve swallowing efficiency.\\n• Diet Modification:: Altering the texture of foods (e.g., pureed, minced) and the thickness of liquids (e.g., nectar-thick, honey-thick) can make them easier and safer to swallow. This must be based on a formal assessment.\\n• Postural Changes:: Techniques like the \"chin tuck\" (tucking the chin down toward the chest) can help protect the airway during the swallow.\\n• Feeding Recommendations:: Patients should be encouraged to feed themselves if possible and be positioned upright during and after meals. Meticulous oral hygiene is crucial to reduce the bacterial load in the mouth and decrease the risk of pneumonia if aspiration does occur.\\n• Restorative (Rehabilitative) Therapies:: These aim to improve the underlying physiology of the swallow.\\n• Swallowing Exercises:: An SLP will prescribe specific exercises to strengthen the muscles of the tongue, lips, and pharynx.\\n• Maneuvers:: Techniques like the effortful swallow or Mendelsohn maneuver are taught to improve coordination and strength.\\n• Neuromuscular Electrical Stimulation (NMES):: Can be used as an adjunct to traditional therapy to stimulate the swallowing muscles.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide12.sections.append(guide12Section2)

        let guide12Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Aspiration Pneumonia:: A lung infection caused by aspirating material into the lungs. Management involves antibiotics and optimizing swallow safety.\\n• Malnutrition and Dehydration:: Can occur if a patient cannot take in adequate nutrition and fluids orally. This is managed by monitoring intake, providing oral nutritional supplements, and, if necessary, using non-oral feeding methods such as a nasogastric (NG) tube for short-term support or a percutaneous endoscopic gastrostomy (PEG) tube for long-term nutritional needs.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide12.sections.append(guide12Section3)

        let guide12Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Post-Stroke Aphasia.\\n• Referenced Assessment Tools: Functional Independence Measure (FIM).",
            displayType: .list,
            orderIndex: 4
        )
        guide12.sections.append(guide12Section4)

        let guide12Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide12.sections.append(guide12Section5)
        context.insert(guide12)

        let guide13 = MedicalContent(
            title: "Post-Stroke Aphasia",
            subtitle: nil,
            contentType: .category,
            category: "Brain Injury Medicine (BIM)",
            overview: "The Brain Injury Medicine (BIM) service is dedicated to the comprehensive management of patients who have sustained traumatic brain injuries (TBI), such as from motor vehicle collisions or falls, and non-traumatic brain injuries, such as those resulting from anoxia, stroke, or central nervous system neoplasms. Physiatry trainees on this service learn to manage patients across the full continuum of care, from the acute hospital setting, through inpatient rehabilitation, and into long-term outpatient follow-up. The curriculum emphasizes the diagnosis and management of a complex constellation of potential sequelae, including disorders of consciousness, cognitive and behavioral impairments, post-traumatic headache, spasticity, neuroendocrine dysfunction, and post-traumatic epilepsy. A central role of the physiatrist is to lead the interdisciplinary rehabilitation team, establish an accurate prognosis, and guide interventions aimed at maximizing functional recovery, independence, and successful community reintegration.",
            keywords: []
        )

        let guide13Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Aphasia is an acquired language disorder caused by damage to the language centers of the brain, most commonly in the left cerebral hemisphere. It affects a person's ability to produce and/or comprehend spoken and written language. It is a disorder of language, not intellect, though cognitive deficits can co-occur.  \n\nThe clinical presentation of aphasia varies widely depending on the location and extent of the brain damage. The major types include :  \n\n Expressive Aphasia (Broca's or Non-fluent Aphasia): Results from damage to the frontal lobe (Broca's area). The hallmark is difficulty with language production. Speech is often slow, halting, and ungrammatical, consisting of short, telegraphic phrases. While patients know what they want to say, they struggle to form the words. Comprehension is typically relatively preserved.    \n Receptive Aphasia (Wernicke's or Fluent Aphasia): Results from damage to the temporal lobe (Wernicke's area). The hallmark is impaired language comprehension. Patients can produce long, grammatically correct sentences, but their speech is often filled with incorrect words, made-up words (neologisms), and nonsensical phrases, making it difficult to understand. They are often unaware of their errors.    \n Anomic Aphasia: This is a milder form of aphasia characterized primarily by word-finding difficulties (anomia). Speech is fluent and grammatical, but patients struggle to find the correct names for objects, people, or places, often substituting vague terms or describing the object's function instead.    \n Global Aphasia: This is the most severe form, resulting from extensive damage to multiple language areas of the brain. It causes profound impairments in all aspects of language—both production and comprehension are severely limited.",
            displayType: .text,
            orderIndex: 0
        )
        guide13.sections.append(guide13Section0)

        let guide13Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• Bedside Screening:: Simple screening tools can be used at the bedside to quickly assess language function, including naming objects, following commands, and repeating phrases.\\n• Comprehensive Language Evaluation:: An SLP will conduct a formal, standardized assessment to characterize the type and severity of aphasia. This evaluation assesses various components of language, including spontaneous speech, auditory comprehension, repetition, naming, reading, and writing.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide13.sections.append(guide13Section1)

        let guide13Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Impairment-Based Therapies:: These therapies aim to directly improve language skills. Examples include:\\n• Constraint-Induced Language Therapy (CILT):: An intensive therapy where the patient is \"constrained\" to use only verbal communication, forcing them to practice and improve their speaking skills.\\n• Melodic Intonation Therapy (MIT):: Uses the musical elements of speech (melody and rhythm) to improve language production, often used for non-fluent aphasia.\\n• Compensatory and Communication-Based Therapies:: These focus on improving overall communication in daily life, even with persistent language deficits.\\n• Promoting Aphasics' Communicative Effectiveness (PACE):: A therapy approach that encourages the use of any and all communication modalities—speaking, writing, drawing, gesturing—to successfully convey a message.\\n• Augmentative and Alternative Communication (AAC):: This involves using tools and devices to supplement or replace speech, ranging from simple picture boards to sophisticated speech-generating devices.\\n• Patient and Family Education:: Educating family members and caregivers on how to best communicate with the person with aphasia is a critical component of management. This includes using simple sentences, speaking slowly, allowing ample time for a response, and using gestures and visual aids.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide13.sections.append(guide13Section2)

        let guide13Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Post-Stroke Dysphagia.\\n• Referenced Assessment Tools: Functional Independence Measure (FIM).",
            displayType: .list,
            orderIndex: 3
        )
        guide13.sections.append(guide13Section3)

        let guide13Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide13.sections.append(guide13Section4)
        context.insert(guide13)

        let guide14 = MedicalContent(
            title: "Phantom Limb Pain (PLP) and Residual Limb Pain (RLP)",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide14Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Following an amputation, patients can experience several distinct types of sensations and pain related to the absent limb. It is critical to differentiate between these phenomena to guide appropriate treatment.\n\n Residual Limb Pain (RLP): Formerly known as \"stump pain,\" RLP is pain that originates from the actual remaining part of the limb. In the immediate post-operative period, it is typically nociceptive pain related to the surgical incision and tissue healing. Chronic RLP, however, often has specific underlying pathologies such as a painful neuroma, heterotopic ossification, bony spurs, infection, ischemia, or skin breakdown from an ill-fitting prosthesis.  \n Phantom Limb Sensation: A non-painful awareness or sensation that the amputated limb is still present. This is a very common, normal phenomenon and is not in itself pathological.  \n* Phantom Limb Pain (PLP): This is the perception of pain in the absent limb. It can be described in various ways, including burning, cramping, shooting, stabbing, or aching. PLP is a form of central neuropathic pain and is a common complication following amputation.\n\nThe pathophysiology of PLP is complex and not fully understood but is believed to result from maladaptive neuroplasticity at multiple levels of the nervous system :\n\n1. Peripheral Mechanisms: During amputation, nerves are severed. The proximal ends of these nerves attempt to regenerate, often forming disorganized tangles of axons and Schwann cells called neuromas. These neuromas can become hyperexcitable, generating spontaneous, ectopic discharges that are interpreted by the brain as pain from the missing limb.  \n2. Spinal Mechanisms (Central Sensitization): The loss of normal sensory input from the limb leads to changes in the dorsal horn of the spinal cord. There is an upregulation of NMDA receptors and increased neuronal activity, making the spinal cord hypersensitive to any incoming signals. Concurrently, there is a loss of descending inhibitory modulation from the brain. This combination of increased excitability and decreased inhibition creates a state of central sensitization that amplifies and maintains pain signals.  \n3. Cortical Reorganization: In the brain, the primary somatosensory and motor cortices undergo significant reorganization. The cortical area that once received input from and controlled the amputated limb is \"invaded\" by representations of neighboring body parts. For example, after a hand amputation, the cortical area for the face may expand into the former hand area. As a result, touching the face can elicit sensations, including pain, in the phantom hand. The extent of this cortical reorganization has been shown to correlate with the intensity of PLP.  \n4. Psychogenic Factors: While not the cause of PLP, psychological factors play a significant role in its modulation and persistence. Comorbid depression, anxiety, and stress can act as triggers and exacerbate the perception of phantom pain, contributing to the development of a chronic pain syndrome.",
            displayType: .text,
            orderIndex: 0
        )
        guide14.sections.append(guide14Section0)

        let guide14Row1_0 = TableRow(cells: ["H", "i", "s", "t", "o", "r", "y", ":", " ", "E", "l", "i", "c", "i", "t", " ", "a", " ", "d", "e", "t", "a", "i", "l", "e", "d", " ", "d", "e", "s", "c", "r", "i", "p", "t", "i", "o", "n", " ", "o", "f", " ", "t", "h", "e", " ", "p", "a", "i", "n", " ", "(", "q", "u", "a", "l", "i", "t", "y", ",", " ", "l", "o", "c", "a", "t", "i", "o", "n", ",", " ", "i", "n", "t", "e", "n", "s", "i", "t", "y", ",", " ", "t", "r", "i", "g", "g", "e", "r", "s", ",", " ", "r", "e", "l", "i", "e", "v", "i", "n", "g", " ", "f", "a", "c", "t", "o", "r", "s", ")", " ", "t", "o", " ", "d", "i", "s", "t", "i", "n", "g", "u", "i", "s", "h", " ", "b", "e", "t", "w", "e", "e", "n", " ", "P", "L", "P", " ", "a", "n", "d", " ", "R", "L", "P", "."], isHeader: true)
        let guide14Row1_1 = TableRow(cells: ["P", "h", "y", "s", "i", "c", "a", "l", " ", "E", "x", "a", "m", "i", "n", "a", "t", "i", "o", "n", ":", " ", "M", "e", "t", "i", "c", "u", "l", "o", "u", "s", "l", "y", " ", "i", "n", "s", "p", "e", "c", "t", " ", "a", "n", "d", " ", "p", "a", "l", "p", "a", "t", "e", " ", "t", "h", "e", " ", "r", "e", "s", "i", "d", "u", "a", "l", " ", "l", "i", "m", "b", ".", " ", "L", "o", "o", "k", " ", "f", "o", "r", " ", "s", "i", "g", "n", "s", " ", "o", "f", " ", "i", "n", "f", "e", "c", "t", "i", "o", "n", ",", " ", "s", "k", "i", "n", " ", "b", "r", "e", "a", "k", "d", "o", "w", "n", ",", " ", "b", "o", "n", "y", " ", "p", "r", "o", "m", "i", "n", "e", "n", "c", "e", "s", ",", " ", "o", "r", " ", "v", "a", "s", "c", "u", "l", "a", "r", " ", "i", "n", "s", "u", "f", "f", "i", "c", "i", "e", "n", "c", "y", ".", " ", "A", "t", "t", "e", "m", "p", "t", " ", "t", "o", " ", "e", "l", "i", "c", "i", "t", " ", "a", " ", "T", "i", "n", "e", "l", "'", "s", " ", "s", "i", "g", "n", " ", "b", "y", " ", "t", "a", "p", "p", "i", "n", "g", " ", "a", "l", "o", "n", "g", " ", "t", "h", "e", " ", "c", "o", "u", "r", "s", "e", " ", "o", "f", " ", "s", "e", "v", "e", "r", "e", "d", " ", "n", "e", "r", "v", "e", "s", " ", "t", "o", " ", "i", "d", "e", "n", "t", "i", "f", "y", " ", "a", " ", "p", "o", "t", "e", "n", "t", "i", "a", "l", " ", "n", "e", "u", "r", "o", "m", "a", "."], isHeader: false)
        let guide14Row1_2 = TableRow(cells: ["D", "i", "a", "g", "n", "o", "s", "t", "i", "c", " ", "T", "o", "o", "l", "s", ":", " ", "W", "h", "i", "l", "e", " ", "n", "o", "t", " ", "d", "i", "a", "g", "n", "o", "s", "t", "i", "c", " ", "f", "o", "r", " ", "P", "L", "P", ",", " ", "i", "m", "a", "g", "i", "n", "g", " ", "c", "a", "n", " ", "b", "e", " ", "u", "s", "e", "d", " ", "t", "o", " ", "i", "n", "v", "e", "s", "t", "i", "g", "a", "t", "e", " ", "R", "L", "P", ".", " ", "A", "n", " ", "u", "l", "t", "r", "a", "s", "o", "u", "n", "d", " ", "o", "r", " ", "M", "R", "I", " ", "c", "a", "n", " ", "h", "e", "l", "p", " ", "i", "d", "e", "n", "t", "i", "f", "y", " ", "a", " ", "n", "e", "u", "r", "o", "m", "a", ",", " ", "a", "b", "s", "c", "e", "s", "s", ",", " ", "o", "r", " ", "h", "e", "t", "e", "r", "o", "t", "o", "p", "i", "c", " ", "o", "s", "s", "i", "f", "i", "c", "a", "t", "i", "o", "n", ".", " ", "A", " ", "C", "B", "C", " ", "c", "a", "n", " ", "h", "e", "l", "p", " ", "r", "u", "l", "e", " ", "o", "u", "t", " ", "i", "n", "f", "e", "c", "t", "i", "o", "n", "."], isHeader: false)
        let guide14Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Classification Systems",
            content: "",
            displayType: .scale,
            tableData: [guide14Row1_0, guide14Row1_1, guide14Row1_2],
            orderIndex: 1
        )
        guide14.sections.append(guide14Section1)

        let guide14Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Pharmacotherapy:**\\n• First-line Agents:: Treatment generally follows the principles of neuropathic pain management. Antidepressants (TCAs like amitriptyline and SNRIs like duloxetine) and anticonvulsants (gabapentin, pregabalin) are considered mainstays.\\n• NMDA Receptor Antagonists:: Some studies have shown a benefit with agents like memantine and ketamine, targeting the central sensitization mechanism in the spinal cord.\\n• Analgesics:: NSAIDs and acetaminophen are commonly used but are often more effective for the nociceptive component of RLP than for the central pain of PLP.\\n• Opioids:: While they can be effective for neuropathic pain, their use for chronic, benign PLP must be approached with extreme caution due to the significant risks of tolerance, dependence, and side effects. They are not considered a first-line therapy and should be used in conjunction with other agents if at all.\\n• **Non-Pharmacologic and Interventional Management:**\\n• Mirror Therapy:: This is a key, evidence-based non-invasive treatment. The patient places their residual limb inside a mirror box and views the reflection of their intact limb. By moving the intact limb, the patient creates a visual illusion of movement in the phantom limb. This visual feedback is thought to help reverse the maladaptive cortical reorganization and can significantly reduce pain.\\n• Graded Motor Imagery (GMI):: A sequential process that includes left/right discrimination, imagined movements, and finally mirror therapy.\\n• Transcutaneous Electrical Nerve Stimulation (TENS):: Can be applied to the residual limb to provide a non-painful sensory input that may help modulate pain signals via the gate control theory.\\n• Prosthetic Use:: A well-fitting prosthesis that provides sensory input to the residual limb can sometimes decrease PLP. Conversely, an ill-fitting prosthesis can cause RLP, which can in turn trigger PLP.\\n• Psychological Interventions:: Cognitive-behavioral therapy (CBT), biofeedback, and management of comorbid depression and anxiety are critical components of a comprehensive treatment plan.\\n• Invasive Procedures:: For refractory RLP caused by a specific neuroma, surgical excision or targeted nerve blocks may be considered.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide14.sections.append(guide14Section2)

        let guide14Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Lower Extremity Amputation Rehabilitation & Prosthetics, Upper Extremity Amputation Rehabilitation & Prosthetics.",
            displayType: .list,
            orderIndex: 3
        )
        guide14.sections.append(guide14Section3)

        let guide14Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide14.sections.append(guide14Section4)
        context.insert(guide14)

        let guide15 = MedicalContent(
            title: "Lower Extremity Amputation Rehabilitation & Prosthetics",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide15Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Rehabilitation following a lower limb amputation is a comprehensive process aimed at restoring mobility, maximizing functional independence, and facilitating a return to life roles. The process is divided into distinct phases, each with specific goals. The level of amputation (e.g., transtibial/below-knee vs. transfemoral/above-knee) significantly impacts the complexity of rehabilitation and the type of prosthesis required.",
            displayType: .text,
            orderIndex: 0
        )
        guide15.sections.append(guide15Section0)

        let guide15Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• Residual Limb Assessment:: The physiatrist and physical therapist evaluate the residual limb (\"stump\") for:\\n• Wound Healing:: The surgical incision must be fully healed and stable.\\n• Edema:: Swelling must be controlled and minimized.\\n• Shape:: The limb should be shaped into a cylindrical or conical form to fit properly into a socket.\\n• Sensation:: To assess for areas of numbness or hypersensitivity.\\n• **Physical Examination:**\\n• Range of Motion (ROM):: Full ROM is needed at the hip and knee (for transtibial amputations) to prevent contractures, which can severely impede prosthetic fitting and gait. Hip and knee extension are particularly critical.\\n• Muscle Strength:: Strength of the residual limb (especially hip extensors and abductors) and the core is essential for prosthetic control and stability.\\n• Intact Limb Health:: The condition of the contralateral limb is assessed, as it will bear increased load.\\n• Functional Status:: Assessment of balance, transfer ability, and cardiovascular fitness helps determine the patient's potential for prosthetic use.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide15.sections.append(guide15Section1)

        let guide15Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Phase 1: Post-Operative / Pre-Prosthetic Phase (Weeks 1-8):**\\n• Wound Care and Edema Control:: The focus is on protecting the healing incision. Edema is managed with elastic shrinker socks or elastic bandaging (figure-8 wrapping) to reduce volume and shape the limb.\\n• Pain Management:: Addressing post-operative pain and phantom limb sensations is critical. Mirror therapy and desensitization techniques (tapping, rubbing the limb) can begin early.\\n• Positioning and Stretching:: Aggressive positioning to prevent contractures is vital. For transtibial amputees, maintaining full knee extension is key (e.g., using a limb support on a wheelchair). For transfemoral amputees, preventing hip flexion contractures by encouraging prone lying is important.\\n• Strengthening and Conditioning:: Exercises focus on the core, upper body, intact limb, and residual limb (hip extensors, abductors, and quadriceps). Aerobic conditioning (e.g., arm ergometer) is initiated to improve endurance.\\n• **Phase 2: Prosthetic Fitting and Training:**\\n• Prosthetic Prescription:: Once the limb is healed and stable (typically 4-6 weeks post-op), the physiatrist and prosthetist prescribe a prosthesis. The first prosthesis is a \"provisional\" or preparatory one, as the residual limb will continue to change shape.\\n• Prosthetic Training:: This is led by the physical therapist and focuses on:\\n• Donning and Doffing:: Learning to put on and take off the prosthesis correctly.\\n• Wear Schedule:: Gradually increasing wear time, starting with short intervals and performing frequent skin checks.\\n• Gait Training:: Begins with basic balance and weight-shifting activities in parallel bars, progressing to walking on level surfaces, ramps, stairs, and uneven terrain. The goal is to achieve a symmetrical and efficient gait pattern.\\n• Advanced Functional Training:: Includes activities like car transfers and fall recovery training.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide15.sections.append(guide15Section2)

        let guide15Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Skin Breakdown:: Caused by poor prosthetic fit, friction, or pressure. Managed by adjusting the socket fit, using appropriate liners/socks, and maintaining good skin hygiene.\\n• Contractures:: Joint stiffness, most commonly hip or knee flexion contractures, that prevent proper prosthetic alignment and gait. Management focuses on prevention through stretching and positioning.\\n• Neuromas:: Painful nerve endings at the incision site. Can be managed with socket modifications, medication, or in some cases, surgical excision.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide15.sections.append(guide15Section3)

        let guide15Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Phantom Limb Pain (PLP) and Residual Limb Pain (RLP).\\n• Referenced Assessment Tools: Functional Independence Measure (FIM).",
            displayType: .list,
            orderIndex: 4
        )
        guide15.sections.append(guide15Section4)

        let guide15Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide15.sections.append(guide15Section5)
        context.insert(guide15)

        let guide16 = MedicalContent(
            title: "Upper Extremity Amputation Rehabilitation & Prosthetics",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide16Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Rehabilitation after an upper extremity (UE) amputation aims to restore function, manage pain, and support psychological adjustment to limb loss. The level of amputation—ranging from a partial hand to a shoulder disarticulation—is a primary determinant of functional loss and prosthetic options. Unlike lower limb amputation where mobility is the main goal, UE amputation rehabilitation focuses on restoring the ability to grasp, hold, and manipulate objects, which is critical for activities of daily living (ADLs), work, and social interaction.  \n\nA key principle in UE rehabilitation is the importance of early prosthetic fitting, ideally within 30 days of amputation. This is crucial to prevent the patient from developing a pattern of one-handedness, which can lead to prosthetic rejection. Early fitting and training increase the likelihood of successful long-term prosthetic use and return to work.",
            displayType: .text,
            orderIndex: 0
        )
        guide16.sections.append(guide16Section0)

        let guide16Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• **Physical Examination:**\\n• Residual Limb:: Assessed for healing, shape, volume, and skin integrity.\\n• Range of Motion and Strength:: ROM and strength of all remaining joints in the affected limb (e.g., shoulder, elbow, forearm rotation) and the contralateral limb are evaluated.\\n• **Functional Assessment:**\\n• Evaluation of hand dominance and independence in ADLs (e.g., feeding, grooming, dressing).\\n• For **body-powered prostheses**, specific movements like shoulder flexion and scapular protraction are assessed for their ability to operate a harness and cable system.\\n• For **myoelectric prostheses**, potential muscle sites in the residual limb are evaluated for their ability to generate clear electromyographic (EMG) signals to control the prosthesis.\\n• Patient Goals:: Identifying the patient's vocational and avocational goals is critical for prescribing the most appropriate prosthesis and ensuring user satisfaction.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide16.sections.append(guide16Section1)

        let guide16Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Pre-Prosthetic Phase:**\\n• Wound and Edema Care:: Similar to lower limb amputation, this involves wound care, edema control with shrinkers, and shaping of the residual limb.\\n• Pain Management:: Addressing post-operative and phantom limb pain.\\n• Therapy:: Occupational therapy focuses on maintaining ROM and strength in the residual limb, strengthening the core and contralateral limb, and training in one-handed ADL techniques. For patients who had their dominant hand amputated, retraining the non-dominant hand begins.\\n• **Prosthetic Training Phase:**\\n• Prosthetic Prescription:: The team collaborates to select the most appropriate type of prosthesis (passive, body-powered, myoelectric, or hybrid) based on the patient's amputation level, functional needs, and goals.\\n• Prosthetic Training:: This is led by the occupational therapist and is essential for successful use. Training includes:\\n• Donning and Doffing:: Learning to put on and take off the prosthesis.\\n• Controls Training:: Mastering the specific movements or muscle contractions needed to operate the terminal device (hand or hook), wrist, and elbow.\\n• Functional Use Training:: Integrating the prosthesis into bimanual (two-handed) tasks and specific ADLs.\\n• Psychological Support:: Adjusting to upper limb loss can be psychologically challenging. Access to psychology services and peer support is a vital component of comprehensive care throughout the rehabilitation journey.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide16.sections.append(guide16Section2)

        let guide16Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Phantom Limb Pain (PLP) and Residual Limb Pain (RLP).\\n• Referenced Assessment Tools: Functional Independence Measure (FIM).",
            displayType: .list,
            orderIndex: 3
        )
        guide16.sections.append(guide16Section3)

        let guide16Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide16.sections.append(guide16Section4)
        context.insert(guide16)

        let guide17 = MedicalContent(
            title: "Cerebral Palsy (CP)",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide17Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Cerebral Palsy (CP) is an umbrella term describing a group of permanent, non-progressive disorders of movement and posture that cause activity limitations. The underlying cause is a disturbance that occurred in the developing fetal or infant brain. While the initial brain lesion is static, the musculoskeletal manifestations can change and progress over time as the child grows.  \n\nCP is classified using three main systems, which together provide a comprehensive picture of the child's condition :  \n\n1. By Motor Impairment Type: This describes the nature of the movement disorder.  \n    Spastic CP: The most common type (\\~80%), characterized by hypertonia (increased muscle tone) and pathological reflexes due to damage to the motor cortex or corticospinal pathways. Muscles are stiff and tight, leading to awkward movements.    \n    Dyskinetic CP: Characterized by involuntary, uncontrolled movements. This includes athetoid (slow, writhing movements) and dystonic (sustained or intermittent muscle contractions causing twisting and repetitive movements) patterns. It results from damage to the basal ganglia.  \n    Ataxic CP: Characterized by problems with balance and coordination, resulting from damage to the cerebellum.  \n    Mixed CP: A combination of more than one motor type is common.  \n2. By Topographical Distribution: This describes which parts of the body are affected, and is most relevant for spastic CP.    \n    Hemiplegia: One side of the body (one arm and one leg) is affected.  \n    Diplegia: Both legs are affected more significantly than the arms.  \n   * Quadriplegia: All four limbs, the trunk, and often the face are involved. This is typically the most severe form.    \n3. By Functional Ability: The Gross Motor Function Classification System (GMFCS) is the gold standard for classifying a child's functional mobility on a five-level scale, from walking without limitations (Level I) to being transported in a manual wheelchair in all settings (Level V).\n\nThe clinical presentation of spastic CP includes stiff, tight muscles, exaggerated reflexes, and abnormal movement patterns. This can lead to characteristic findings such as toe walking, a \"scissoring\" gait (where the knees cross due to tight hip adductors), and the eventual development of fixed muscle and joint contractures.",
            displayType: .text,
            orderIndex: 0
        )
        guide17.sections.append(guide17Section0)

        let guide17Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Classification Systems",
            content: "",
            displayType: .scale,
            tableData: [],
            orderIndex: 1
        )
        guide17.sections.append(guide17Section1)

        let guide17Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Therapies:: Physical therapy (PT), occupational therapy (OT), and speech-language pathology (SLP) are the cornerstones of CP management from the time of diagnosis.\\n• PT: focuses on improving mobility, strength, balance, and gait, and preventing contractures through stretching and range-of-motion exercises.\\n• OT: focuses on improving fine motor skills, participation in activities of daily living (ADLs) like dressing and feeding, and use of adaptive equipment.\\n• SLP: addresses issues with speech, language, and swallowing (dysphagia).\\n• Spasticity Management:: This is a central focus of physiatric care in CP, as uncontrolled spasticity leads to pain, contractures, and functional decline.\\n• Oral Medications:: Muscle relaxants like baclofen, diazepam, and tizanidine can be used for generalized spasticity, but their use is often limited by side effects such as drowsiness and fatigue, which can interfere with a child's participation in school and therapy.\\n• Focal Spasticity Treatment (Botulinum Toxin):: For spasticity affecting specific muscles (e.g., calf muscles causing toe walking, hamstrings limiting knee extension), injections of botulinum toxin A (Botox) are a first-line treatment. The injections temporarily weaken the target muscles for about 3-4 months. This period of reduced tone creates a \"window of opportunity\" for intensive physical therapy and serial casting or bracing to lengthen the muscle and improve function.\\n• Generalized Spasticity Treatment (Intrathecal Baclofen \\- ITB):: For children with severe, generalized spasticity (especially in the lower extremities) that is not manageable with oral medications, an ITB pump is a highly effective option. A small, programmable pump is surgically implanted in the abdomen, and a catheter delivers a continuous infusion of baclofen directly into the intrathecal space, providing potent spasticity relief with minimal systemic side effects.\\n• Neurosurgery (Selective Dorsal Rhizotomy \\- SDR):: This is a surgical procedure considered for select children with spastic diplegia who have good underlying strength. The surgeon selectively cuts sensory nerve rootlets in the lumbar spine that are contributing to spasticity, resulting in a permanent reduction in tone in the legs.\\n• **Orthotics and Equipment:**\\n• Bracing:: Ankle-Foot Orthoses (AFOs) are commonly prescribed to control ankle spasticity, prevent equinus contractures, and provide a stable base for walking. Other braces for the hands, wrists, or trunk may also be used.\\n• Adaptive Equipment:: A wide range of equipment, from specialized seating to adaptive walkers and wheelchairs, is used to promote posture, mobility, and independence.\\n• Orthopedic Surgery:: As a child grows, spasticity and muscle imbalances can lead to bony deformities and joint dislocations (especially of the hips). Orthopedic surgery, such as tendon lengthening, tendon transfers, or osteotomies (cutting and realigning bone), may be necessary to correct these problems and improve function.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide17.sections.append(guide17Section2)

        let guide17Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Pain (from spasticity, contractures, or hip subluxation)\\n• Hip dysplasia and dislocation\\n• Scoliosis\\n• Epilepsy\\n• Feeding difficulties and malnutrition (requiring G-tube placement)\\n• Constipation\\n• Visual and hearing impairments\\n• Intellectual disability and learning disabilities",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide17.sections.append(guide17Section3)

        let guide17Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Spasticity Management in SCI (for comparison of principles).\\n• Referenced Assessment Tools: Modified Ashworth Scale (MAS), Tardieu Scale.",
            displayType: .list,
            orderIndex: 4
        )
        guide17.sections.append(guide17Section4)

        let guide17Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide17.sections.append(guide17Section5)
        context.insert(guide17)

        let guide18 = MedicalContent(
            title: "Myelomeningocele (Spina Bifida)",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide18Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Myelomeningocele is the most severe form of spina bifida, a type of neural tube defect where the spinal canal fails to close completely during fetal development. This results in a fluid-filled sac protruding from the baby's back, which contains not only cerebrospinal fluid but also the meninges and a portion of the malformed spinal cord and nerves. The damage to the exposed spinal cord is permanent and leads to a range of lifelong disabilities.\n\nThe clinical presentation is highly variable and depends on the location and severity of the lesion on the spine. Higher lesions (thoracic or high lumbar) result in more significant impairments. Common associated conditions and impairments include:\n\n Motor and Sensory Deficits: Paralysis or weakness of the legs, leading to impaired mobility and the need for braces, crutches, or a wheelchair. There is also a corresponding loss of sensation below the level of the lesion.  \n Hydrocephalus: A buildup of excess cerebrospinal fluid in the brain, which is present in the vast majority of infants with myelomeningocele.  \n Chiari II Malformation: A structural defect where brain tissue extends into the spinal canal, which is almost universally present and can cause issues with breathing, swallowing, and upper extremity coordination.  \n Neurogenic Bladder and Bowel: Lack of nervous system control over bladder and bowel function, leading to incontinence and risk of kidney damage.  \n* Orthopedic Issues: High incidence of hip dislocation, clubfoot, and scoliosis due to muscle imbalances.",
            displayType: .text,
            orderIndex: 0
        )
        guide18.sections.append(guide18Section0)

        let guide18Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• Maternal Serum Alpha-Fetoprotein (MSAFP) Screen:: A blood test performed during the second trimester can show elevated levels of AFP, a protein produced by the fetus, suggesting a neural tube defect.\\n• Fetal Ultrasound:: This is the most accurate method for diagnosis. A detailed second-trimester ultrasound can visualize the open spine and characteristic changes in the fetal brain known as \"fruit signs\" (the \"lemon sign\" of the skull and \"banana sign\" of the cerebellum).\\n• Amniocentesis:: May be performed to confirm the diagnosis by measuring AFP levels in the amniotic fluid and to rule out associated genetic conditions.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide18.sections.append(guide18Section1)

        let guide18Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Surgical Closure:: The primary intervention is surgery to close the opening on the baby's back. This can be done either prenatally (fetal surgery) or, more commonly, within the first 48 hours after birth to reduce the risk of infection. Fetal surgery may reduce the need for a shunt but carries its own risks.\\n• Hydrocephalus Management:: Most infants will require a ventriculoperitoneal (VP) shunt, a surgically implanted device that drains excess fluid from the brain to the abdominal cavity.\\n• Urologic Management:: This is critical to preserve kidney function. Management typically involves clean intermittent catheterization (CIC) on a regular schedule and may include medications to relax the bladder.\\n• Bowel Management:: A structured bowel program involving diet, medications, and timed toileting is necessary to manage constipation and incontinence.\\n• Orthopedic Management:: Regular monitoring for and treatment of scoliosis, hip dislocations, and foot deformities is required. This may involve bracing or surgical correction.\\n• Physical and Occupational Therapy:: PT and OT are essential from infancy to maximize mobility, teach ADLs, and prescribe appropriate adaptive equipment, bracing, and wheelchairs.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide18.sections.append(guide18Section2)

        let guide18Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• VP Shunt Malfunction:: A common and potentially life-threatening complication that can present with headache, vomiting, lethargy, or swelling along the shunt tract. It requires urgent neurosurgical evaluation.\\n• Tethered Spinal Cord Syndrome:: Scar tissue can cause the spinal cord to become \"stuck\" as the child grows, leading to new or worsening weakness, back pain, or changes in bladder/bowel function. This often requires surgical release.\\n• Latex Allergy:: Individuals with spina bifida have a very high incidence of latex allergy, and latex-free precautions should be maintained.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide18.sections.append(guide18Section3)

        let guide18Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Neurogenic Bladder Management in SCI, Neurogenic Bowel Management in SCI.\\n• Referenced Assessment Tools: Functional Independence Measure (FIM).",
            displayType: .list,
            orderIndex: 4
        )
        guide18.sections.append(guide18Section4)

        let guide18Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide18.sections.append(guide18Section5)
        context.insert(guide18)

        let guide19 = MedicalContent(
            title: "Duchenne Muscular Dystrophy (DMD)",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide19Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Duchenne muscular dystrophy (DMD) is a severe, progressive, X-linked genetic disorder characterized by the absence of the protein dystrophin. Dystrophin acts as a shock absorber in muscle cells, and without it, muscle fibers are easily damaged during contraction, leading to progressive muscle weakness and degeneration, which is eventually replaced by fat and fibrous tissue.\n\nBecause it is an X-linked disorder, DMD primarily affects boys. Symptoms typically appear between ages 2 and 4\\. The clinical presentation includes:\n\n Progressive Muscle Weakness: Weakness begins in the proximal muscles of the hips and shoulders and progresses distally.  \n Delayed Motor Milestones: Toddlers may be late to sit, stand, or walk.  \n Gait Abnormalities: A characteristic waddling gait and walking on the toes are common.  \n Gowers' Sign: A classic sign where a child uses their hands to \"climb up\" their own legs to rise from the floor due to weak hip and thigh muscles.  \n Calf Pseudohypertrophy: The calf muscles may appear unusually large due to the replacement of muscle tissue with fat and scar tissue.  \n Loss of Ambulation: Most boys with DMD lose the ability to walk and require a wheelchair by their early teens.",
            displayType: .text,
            orderIndex: 0
        )
        guide19.sections.append(guide19Section0)

        let guide19Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• History and Physical Exam:: A history of motor delays and observation of classic signs like Gowers' maneuver and calf pseudohypertrophy are highly suggestive.\\n• Creatine Kinase (CK) Blood Test:: This is a key screening test. Damaged muscles leak CK into the bloodstream, and in DMD, CK levels are extremely elevated, often 10 to 20 times the upper limit of normal.\\n• Genetic Testing:: A blood test for genetic analysis is the definitive diagnostic test. It can identify the specific mutation in the dystrophin gene, confirming the diagnosis.\\n• Muscle Biopsy:: While less common now due to the accuracy of genetic testing, a muscle biopsy can show the absence of dystrophin protein and characteristic muscle fiber changes.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide19.sections.append(guide19Section1)

        let guide19Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Corticosteroids:: Medications like prednisone and deflazacort are the cornerstone of pharmacologic management. They can slow the progression of muscle weakness, preserve walking ability for several years, and protect heart and lung function.\\n• Gene-Based Therapies:: Newer FDA-approved medications (e.g., eteplirsen, golodirsen) are designed to \"skip\" over specific errors in the dystrophin gene, allowing for the production of a shortened but partially functional dystrophin protein. These are only effective for specific genetic mutations.\\n• Physical Therapy:: PT is vital throughout the course of the disease. The focus is on gentle stretching and range of motion exercises to prevent joint contractures, particularly at the ankles, knees, and hips.\\n• Cardiac Management:: Cardiomyopathy is a universal complication. Regular cardiac monitoring with EKGs and echocardiograms should begin in early childhood. ACE inhibitors and beta-blockers are used to protect heart function.\\n• Respiratory Management:: As the disease progresses, respiratory muscles weaken. Regular monitoring of pulmonary function is essential. Non-invasive ventilation (e.g., BiPAP), especially at night, and cough-assist devices are used to support breathing and clear secretions.\\n• Orthopedic Management:: Scoliosis (curvature of the spine) often develops after the loss of ambulation and may require surgical correction to maintain sitting posture and respiratory function.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide19.sections.append(guide19Section2)

        let guide19Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Cardiomyopathy:: Progressive weakening of the heart muscle is a leading cause of mortality. Managed with cardiac medications and close monitoring.\\n• Respiratory Failure:: Weakness of the diaphragm and other respiratory muscles leads to breathing difficulties. Managed with ventilatory support.\\n• Joint Contractures and Scoliosis:: Managed with therapy, bracing, and orthopedic surgery.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide19.sections.append(guide19Section3)

        let guide19Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Cerebral Palsy (for comparison of pediatric motor disorders).\\n• Referenced Assessment Tools: Functional Independence Measure (FIM).",
            displayType: .list,
            orderIndex: 4
        )
        guide19.sections.append(guide19Section4)

        let guide19Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide19.sections.append(guide19Section5)
        context.insert(guide19)

        let guide20 = MedicalContent(
            title: "Brachial Plexus Birth Palsy (BPBP)",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide20Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Brachial plexus birth palsy (BPBP) is an injury to the network of nerves (the brachial plexus) that controls movement and sensation in the arm. It occurs during birth when the baby's neck is stretched to one side, damaging the nerve roots. The most common risk factor is shoulder dystocia, where the baby's shoulder gets stuck during delivery.\n\nThe clinical presentation depends on which nerves are injured:\n\n Erb's Palsy (Upper Trunk Injury, C5-C6): This is the most common type. It affects the muscles of the shoulder and elbow. The infant presents with the characteristic \"waiter's tip\" posture: the arm hangs at the side, internally rotated at the shoulder, with the elbow extended and the wrist flexed.  \n Klumpke's Palsy (Lower Trunk Injury, C8-T1): This is much rarer and affects the muscles of the hand and fingers, causing a \"claw hand\" deformity.  \n* Total Plexus Palsy (C5-T1): This involves injury to the entire plexus, resulting in a completely flail and insensate arm.",
            displayType: .text,
            orderIndex: 0
        )
        guide20.sections.append(guide20Section0)

        let guide20Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• Physical Examination:: The key finding is decreased or absent movement in the affected arm. The examiner will note the arm's posture at rest and assess for an asymmetric Moro (startle) reflex, where the affected arm does not abduct and extend like the unaffected arm.\\n• Imaging:: An X-ray is often performed to rule out an associated clavicle or humerus fracture, which can present similarly. For severe injuries or for surgical planning, an MRI or electrodiagnostic studies (EMG/NCS) may be used to better define the extent and location of the nerve injury.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide20.sections.append(guide20Section1)

        let guide20Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Conservative Management (Physical and Occupational Therapy):: This is the initial treatment for all infants with BPBP. Therapy begins within the first few weeks of life and focuses on:\\n• Gentle Range of Motion Exercises:: The primary goal is to perform daily passive stretching exercises to prevent the development of joint stiffness and contractures while waiting for nerve recovery.\\n• Positional Awareness and Stimulation:: Encouraging the infant to use and be aware of the affected arm.\\n• Surgical Management:: Surgery is considered for infants who do not show adequate spontaneous recovery. The critical indicator for surgery is the lack of anti-gravity biceps function (the ability to bend the elbow) by 3 to 6 months of age.\\n• Primary Nerve Surgery (Microsurgery):: Performed between 4 and 9 months of age, this involves exploring the brachial plexus and performing nerve grafts (using a nerve from another part of the body to bridge a gap) or nerve transfers (rerouting a nearby healthy nerve to power a more important muscle).\\n• Secondary Procedures:: For older children with residual deficits and muscle imbalances, orthopedic procedures like tendon transfers or osteotomies (cutting and realigning bone) can be performed to improve shoulder or hand function.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide20.sections.append(guide20Section2)

        let guide20Section3 = ContentSection(
            title: "Prognosis",
            content: "The prognosis for BPBP is generally good, with 70-90% of infants achieving a full or near-full recovery with conservative management alone within the first year. For those who require surgery, outcomes are variable, but significant functional improvement can often be achieved.",
            displayType: .text,
            orderIndex: 3
        )
        guide20.sections.append(guide20Section3)

        let guide20Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Cerebral Palsy.\\n• Referenced Assessment Tools: Manual Muscle Testing.",
            displayType: .list,
            orderIndex: 4
        )
        guide20.sections.append(guide20Section4)

        let guide20Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide20.sections.append(guide20Section5)
        context.insert(guide20)

        let guide21 = MedicalContent(
            title: "Low Back Pain: A Diagnostic and Management Framework",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide21Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Low back pain (LBP) is an extremely common condition. The vast majority of cases are classified as non-specific LBP, where a precise anatomical cause cannot be identified. This is often attributed to muscle or ligamentous strain.\n\nA smaller percentage of LBP cases have a specific structural cause, which can often be suggested by the clinical presentation:\n\n Lumbar Radiculopathy (Sciatica): This is pain that radiates down the leg in a dermatomal pattern, caused by compression or irritation of a nerve root, most commonly from a herniated intervertebral disc. Leg pain is often worse than the back pain itself.  \n Lumbar Spinal Stenosis: A narrowing of the spinal canal, which compresses the nerve roots. This typically causes neurogenic claudication: bilateral leg pain, numbness, and weakness that is brought on by walking or standing and relieved by sitting or leaning forward (the \"shopping cart sign\").",
            displayType: .text,
            orderIndex: 0
        )
        guide21.sections.append(guide21Section0)

        let guide21Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• History:: A thorough history is the most important part of the evaluation.\\n• Red Flags:: The clinician must ask about a history of cancer, unexplained weight loss, fever, recent infection, intravenous drug use, immunosuppression, significant trauma, and bowel or bladder incontinence or urinary retention (suggesting **Cauda Equina Syndrome**, a surgical emergency).\\n• Pain Characteristics:: The location of the pain (back vs. leg), its radiation pattern, and what makes it better or worse can provide clues to the etiology.\\n• **Physical Examination:**\\n• Neurological Exam:: Includes testing strength, sensation, and reflexes in the lower extremities.\\n• Special Tests:: The **Straight Leg Raise (SLR)** test is a key maneuver for identifying lumbosacral nerve root tension, suggestive of a disc herniation.\\n• Imaging:: For non-specific LBP without red flags, imaging is **not** recommended in the acute phase (first 6 weeks), as it does not improve outcomes and can lead to unnecessary interventions. Imaging (MRI) is indicated if there are red flag symptoms, progressive neurological deficits, or if pain persists despite conservative management and a specific intervention (like surgery or an epidural injection) is being considered.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide21.sections.append(guide21Section1)

        let guide21Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Patient Education:: This is a critical first step. Patients should be reassured that the prognosis is good and advised to stay active as tolerated. Prolonged bed rest is detrimental. Education on proper posture and lifting mechanics is also important.\\n• **Pharmacology:**\\n• First-line:: Nonsteroidal anti-inflammatory drugs (NSAIDs) or acetaminophen can be used for pain relief.\\n• Muscle Relaxants:: May be considered for a short course for severe pain and spasms.\\n• Opioids:: Should generally be avoided for chronic LBP due to risks of dependence and lack of long-term efficacy.\\n• Physical Therapy:: PT is a cornerstone of management.\\n• Manual Therapy and Exercise:: Specific exercise approaches like the McKenzie method (emphasizing extension) or stabilization exercises (strengthening core and trunk muscles) can be effective.\\n• Stretching:: Simple stretches like the knee-to-chest stretch and lower back rotational stretches can help relieve stiffness.\\n• Interventional Procedures:: For persistent radicular pain from a herniated disc or pain from spinal stenosis, **epidural steroid injections** may be considered to provide short-term pain relief, though recent evidence suggests their effect may be small. For pain presumed to be from the facet joints, procedures like medial branch blocks and radiofrequency ablation are performed.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide21.sections.append(guide21Section2)

        let guide21Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Myofascial Pain Syndrome & Trigger Point Injections.\\n• Referenced Assessment Tools: Straight Leg Raise Test.",
            displayType: .list,
            orderIndex: 3
        )
        guide21.sections.append(guide21Section3)

        let guide21Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide21.sections.append(guide21Section4)
        context.insert(guide21)

        let guide22 = MedicalContent(
            title: "Shoulder Impingement Syndrome",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide22Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Shoulder impingement syndrome is a common cause of shoulder pain that occurs when the soft tissues in the subacromial space are compressed or \"impinged.\" This space is located between the acromion (the top outer edge of the shoulder blade) and the humeral head (the \"ball\" of the shoulder joint). The structures within this space include the rotator cuff tendons (most commonly the supraspinatus) and the subacromial bursa.\n\nThe impingement is typically caused by a combination of factors:\n\n Functional/Overuse: Repetitive overhead activities, such as those in swimming, throwing sports, or certain occupations, can lead to inflammation of the tendons (tendinitis) and bursa (bursitis), causing them to swell and narrow the subacromial space. Poor posture and weakness of the scapular stabilizing muscles can also contribute.  \n Structural: Anatomic factors, such as the shape of the acromion or the presence of bone spurs, can intrinsically narrow the space and predispose an individual to impingement.\n\nThe classic clinical presentation is pain in the shoulder, often radiating from the front of the shoulder to the side of the arm. The pain is typically worse with overhead activities and may also be present at night, interfering with sleep.",
            displayType: .text,
            orderIndex: 0
        )
        guide22.sections.append(guide22Section0)

        let guide22Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• History:: A history of repetitive overhead activity and pain with reaching overhead is highly suggestive.\\n• **Physical Examination:**\\n• Painful Arc:: Pain experienced when the arm is actively raised to the side, typically between 60 and 120 degrees of abduction.\\n• Provocative Tests:: Specific maneuvers are used to intentionally narrow the subacromial space and reproduce the patient's pain. Common tests include the **Neer test** and the **Hawkins-Kennedy test**.\\n• Strength Testing:: To assess the integrity of the rotator cuff muscles.\\n• **Imaging:**\\n• X-rays:: Can identify structural issues like bone spurs.\\n• Ultrasound or MRI:: These are not typically needed to diagnose impingement but are used to evaluate the rotator cuff tendons for inflammation, tendinosis, or tearing if symptoms do not improve with conservative treatment.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide22.sections.append(guide22Section1)

        let guide22Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Activity Modification and Rest:: The first step is to avoid the aggravating overhead activities to allow the inflammation to subside.\\n• **Pain and Inflammation Control:**\\n• Ice:: Applying ice can help reduce pain and swelling.\\n• NSAIDs:: Over-the-counter nonsteroidal anti-inflammatory drugs (e.g., ibuprofen) can be used for a short course to manage pain.\\n• Corticosteroid Injections:: An injection of cortisone into the subacromial space can provide potent anti-inflammatory effects and significant pain relief, which can facilitate more effective participation in physical therapy.\\n• Physical Therapy:: This is the cornerstone of treatment. The focus is on:\\n• Stretching:: To restore any lost range of motion.\\n• Strengthening:: A targeted program to strengthen the rotator cuff muscles and the muscles that stabilize the scapula (shoulder blade). This improves the dynamics of the shoulder joint, creating more space and reducing impingement.\\n• Surgical Management:: Surgery is reserved for cases that fail to improve after several months of dedicated conservative treatment. The most common procedure is an **arthroscopic subacromial decompression**, where a surgeon removes bone spurs and inflamed bursal tissue to create more space for the rotator cuff tendons.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide22.sections.append(guide22Section2)

        let guide22Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Low Back Pain.\\n• Referenced Assessment Tools: Neer Test, Hawkins-Kennedy Test.",
            displayType: .list,
            orderIndex: 3
        )
        guide22.sections.append(guide22Section3)

        let guide22Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide22.sections.append(guide22Section4)
        context.insert(guide22)

        let guide23 = MedicalContent(
            title: "Carpal Tunnel Syndrome (CTS)",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide23Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Carpal tunnel syndrome (CTS) is the most common entrapment neuropathy, caused by compression of the median nerve as it passes through the carpal tunnel at the wrist. The carpal tunnel is a narrow passageway formed by the carpal bones and the transverse carpal ligament. Any condition that decreases the size of this tunnel or increases the volume of the structures within it (nine flexor tendons and the median nerve) can lead to increased pressure and compression of the nerve.\n\nThis compression leads to the characteristic symptoms of CTS, which include :\n\n Numbness and Tingling (Paresthesias): In the sensory distribution of the median nerve—the thumb, index finger, middle finger, and the radial (thumb side) half of the ring finger.  \n Nocturnal Symptoms: Symptoms are often worse at night, frequently waking the patient from sleep. This is thought to be due to fluid shifts and prolonged wrist flexion during sleep.  \n* Weakness and Clumsiness: As the condition progresses, patients may experience weakness in the thumb (thenar) muscles, leading to difficulty with fine motor tasks and a tendency to drop objects.\n\nRisk factors include female sex, obesity, pregnancy, diabetes, and rheumatoid arthritis.",
            displayType: .text,
            orderIndex: 0
        )
        guide23.sections.append(guide23Section0)

        let guide23Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• History:: A classic history of nocturnal paresthesias in the median nerve distribution is highly suggestive.\\n• **Physical Examination:**\\n• Provocative Maneuvers:: These tests are designed to temporarily increase pressure on the median nerve and reproduce the patient's symptoms.\\n• Phalen's Test:: The patient holds their wrists in maximal flexion (e.g., by pressing the backs of the hands together) for up to 60 seconds. A positive test is the reproduction of numbness or tingling.\\n• Tinel's Sign:: The examiner taps gently over the median nerve at the wrist. A positive test elicits a tingling or \"pins-and-needles\" sensation in the fingers.\\n• Electrodiagnostic Studies (NCS/EMG):: These are the gold standard for confirming the diagnosis and assessing the severity of nerve compression. Nerve conduction studies (NCS) will show slowing of the median nerve's sensory and/or motor signals as they cross the wrist.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide23.sections.append(guide23Section1)

        let guide23Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Conservative Management:**\\n• Wrist Splinting:: Wearing a neutral-position wrist splint, particularly at night, is a key first-line treatment. This prevents wrist flexion and reduces pressure on the nerve during sleep.\\n• Activity Modification:: Avoiding or modifying activities that involve prolonged or repetitive wrist flexion can help reduce symptoms.\\n• Nerve Gliding Exercises:: Specific exercises can help the median nerve move more freely within the carpal tunnel.\\n• Corticosteroid Injections:: An injection of corticosteroid directly into the carpal tunnel can provide potent anti-inflammatory effects and often provides significant, albeit sometimes temporary, symptom relief.\\n• **Surgical Management:**\\n• Carpal Tunnel Release:: If conservative measures fail or if there is evidence of severe nerve damage (e.g., thenar muscle atrophy), surgery is recommended. The procedure involves cutting the transverse carpal ligament to increase the volume of the tunnel and relieve pressure on the median nerve.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide23.sections.append(guide23Section2)

        let guide23Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Electrodiagnostic Medicine (EMG/NCS) Principles.\\n• Referenced Assessment Tools: Phalen's Test, Tinel's Sign.",
            displayType: .list,
            orderIndex: 3
        )
        guide23.sections.append(guide23Section3)

        let guide23Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide23.sections.append(guide23Section4)
        context.insert(guide23)

        let guide24 = MedicalContent(
            title: "Complex Regional Pain Syndrome (CRPS)",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide24Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Complex Regional Pain Syndrome (CRPS) is a form of chronic pain that usually affects an arm or a leg. It is characterized by an aberrant and amplified inflammatory and sympathetic nervous system response, typically following a minor injury or surgery. The hallmark of CRPS is pain that is disproportionate in intensity and duration to the initial inciting event.  \n\nThe pathophysiology is not fully understood but is thought to involve a combination of peripheral and central sensitization, neurogenic inflammation, and autonomic dysfunction.\n\nThe clinical presentation is complex and involves a constellation of signs and symptoms in the affected limb :\n\n Sensory: Spontaneous, severe, burning pain. Hyperalgesia (exaggerated response to a painful stimulus) and allodynia (pain from a stimulus that does not normally cause pain, like light touch).  \n Vasomotor: Changes in skin temperature (feeling warmer or cooler than the opposite limb) and skin color (appearing red, blue, or mottled).  \n Sudomotor/Edema: Swelling (edema) and changes in sweating patterns (either increased or decreased sweating).  \n Motor/Trophic: Decreased range of motion, weakness, tremor, or abnormal posturing (dystonia). Trophic changes include alterations in hair and nail growth, and thin, shiny skin.",
            displayType: .text,
            orderIndex: 0
        )
        guide24.sections.append(guide24Section0)

        let guide24Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• The diagnosis of CRPS is clinical; there is no single confirmatory test.\\n• The **Budapest Criteria** are the accepted standard for diagnosis.\\n• To meet the criteria, the patient must have continuing pain that is disproportionate to the inciting event, and report symptoms and display signs in several of the categories listed above.\\n• The diagnosis also requires that no other condition can better explain the signs and symptoms.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide24.sections.append(guide24Section1)

        let guide24Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Physical and Occupational Therapy:: This is the cornerstone of treatment.\\n• Graded Motor Imagery (GMI):: A sequential therapy that includes laterality (left/right) recognition, imagined movements, and finally **Mirror Therapy**. Mirror therapy involves using a mirror to create a visual illusion of the affected limb moving normally, which can help retrain the brain and reduce pain.\\n• Desensitization:: Gradually increasing sensory input to the limb to reduce allodynia and hypersensitivity.\\n• Mobility and Strengthening:: Gentle exercises to maintain range of motion and improve function.\\n• Pharmacology:: Medications are used to manage symptoms.\\n• Neuropathic Pain Agents:: Antidepressants and anticonvulsants are often used.\\n• NSAIDs:: For inflammation.\\n• Bisphosphonates:: Can be helpful for bone changes seen in CRPS.\\n• Corticosteroids:: A short course may be used in the acute, inflammatory phase.\\n• **Interventional Procedures:**\\n• Sympathetic Nerve Blocks:: An injection of local anesthetic to block the sympathetic nerves supplying the affected limb. This can be both diagnostic (if it provides significant pain relief) and therapeutic.\\n• Spinal Cord Stimulation (SCS):: For severe, refractory CRPS, an implantable SCS device can modulate pain signals at the spinal cord level.\\n• Psychological Support:: Addressing the significant psychological distress, anxiety, and depression that often accompany CRPS is a critical part of the treatment plan.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide24.sections.append(guide24Section2)

        let guide24Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Phantom Limb Pain (PLP) and Residual Limb Pain (RLP).\\n• Referenced Assessment Tools: Visual Analog Scale.",
            displayType: .list,
            orderIndex: 3
        )
        guide24.sections.append(guide24Section3)

        let guide24Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide24.sections.append(guide24Section4)
        context.insert(guide24)

        let guide25 = MedicalContent(
            title: "Myofascial Pain Syndrome & Trigger Point Injections",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide25Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Myofascial pain syndrome is a common chronic pain condition characterized by the presence of myofascial trigger points. A trigger point is a hyperirritable, focal \"knot\" located within a taut band of skeletal muscle. These points are painful upon compression and can give rise to a characteristic pattern of referred pain, tenderness, and autonomic phenomena.\n\nThe pathophysiology is thought to be related to dysfunction at the motor end-plate of the muscle, leading to sustained muscle fiber contraction and a localized energy crisis. This creates a cycle of pain, muscle tension, and further dysfunction. Trigger points can develop after acute muscle trauma or from chronic, repetitive micro-trauma and overuse.",
            displayType: .text,
            orderIndex: 0
        )
        guide25.sections.append(guide25Section0)

        let guide25Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• The diagnosis of myofascial pain syndrome is entirely clinical, based on a careful physical examination.\\n• There are no laboratory or imaging tests to confirm the diagnosis.\\n• The key diagnostic findings on palpation are :\n\n1.\\n• A palpable **taut band** within a muscle.\\n• An exquisitely tender **nodule** within that taut band (the trigger point).\\n• **Reproduction of the patient's typical pain** upon pressure to the trigger point.\\n• A **local twitch response**, which is a visible or palpable transient contraction of the muscle fibers in the taut band when the trigger point is stimulated (e.g., by snapping palpation or needle insertion).",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide25.sections.append(guide25Section1)

        let guide25Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Manual Therapies:: Physical therapists and other manual practitioners use techniques like ischemic compression, massage, and post-isometric relaxation to release trigger points.\\n• Stretching:: Regular stretching of the affected muscles is crucial to restore normal muscle length and break the pain-tension cycle.\\n• Trigger Point Injections (TPIs):: This is a common and effective intervention performed by physiatrists and pain specialists.\\n• Technique:: The clinician identifies the trigger point, stabilizes the tissue, and inserts a small needle into the knot. The needle is repeatedly moved in and out to mechanically disrupt the trigger point until the local twitch response subsides.\\n• Injectate:: The procedure can be done with \"dry needling\" (no substance injected) or with an injection of a small amount of local anesthetic (e.g., lidocaine). Injecting an anesthetic can reduce post-procedure soreness. Corticosteroids are sometimes added but are not typically necessary.\\n• Post-Injection Care:: Following an injection, it is important to apply ice or a cold pack to reduce soreness and to perform gentle stretching of the treated muscle. The injection provides a \"window of opportunity\" where the pain is reduced, allowing for more effective participation in a physical therapy program to address underlying postural or biomechanical issues.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide25.sections.append(guide25Section2)

        let guide25Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Low Back Pain: A Diagnostic and Management Framework.\\n• Referenced Assessment Tools: Visual Analog Scale.",
            displayType: .list,
            orderIndex: 3
        )
        guide25.sections.append(guide25Section3)

        let guide25Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide25.sections.append(guide25Section4)
        context.insert(guide25)

        let guide26 = MedicalContent(
            title: "Chemotherapy-Induced Peripheral Neuropathy (CIPN)",
            subtitle: nil,
            contentType: .category,
            category: "Amputee Care",
            overview: "The amputee care rotation provides trainees with comprehensive experience in the rehabilitation of individuals following limb loss. The physiatrist is an integral leader of the interdisciplinary team, which critically includes physical therapists, occupational therapists, and prosthetists. The curriculum covers the full spectrum of care, beginning with the pre-amputation consultation (\"pre-hab\") when possible, and extending through acute post-surgical management, pre-prosthetic training, prosthetic prescription, and lifelong follow-up. Key learning objectives include management of the residual limb (wound healing, edema control, shaping), prescription of appropriate prosthetic components based on the patient's functional level and goals, training in the use of the prosthesis, and diagnosis and treatment of common associated conditions such as residual limb pain and phantom limb pain.",
            keywords: []
        )

        let guide26Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Chemotherapy-induced peripheral neuropathy (CIPN) is a common, dose-limiting side effect of many neurotoxic anticancer drugs. It results from damage to the peripheral nerves, particularly the long sensory and motor axons. The pathophysiology varies depending on the specific drug but often involves interference with microtubule function, mitochondrial damage, and oxidative stress, leading to axonal degeneration.\n\nThe most common agents causing CIPN include:\n\n Platinum-based drugs (e.g., cisplatin, oxaliplatin)  \n Taxanes (e.g., paclitaxel, docetaxel)  \n Vinca alkaloids (e.g., vincristine)\n\nThe clinical presentation is typically a length-dependent, \"glove and stocking\" sensorimotor polyneuropathy. Symptoms usually begin in the toes and fingers and progress proximally.\n\n Sensory Symptoms: These are most prominent and include numbness, tingling, burning pain, and a loss of proprioception (joint position sense). Loss of sensation can lead to significant functional problems, such as difficulty with fine motor tasks (buttoning shirts) and an increased risk of falls due to poor balance.  \n Motor Symptoms: Distal weakness can occur, leading to problems like foot drop.  \n Autonomic Symptoms: Less common, but can include orthostatic hypotension or constipation.",
            displayType: .text,
            orderIndex: 0
        )
        guide26.sections.append(guide26Section0)

        let guide26Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Assessment",
            content: "• History:: A history of exposure to a known neurotoxic chemotherapy agent, combined with the onset of typical symptoms, is key.\\n• Neurological Examination:: The exam will reveal sensory loss in a stocking-glove distribution, decreased or absent ankle reflexes, and potentially distal weakness.\\n• Electrodiagnostic Studies (NCS/EMG):: While not always necessary for diagnosis, nerve conduction studies can confirm the presence of a length-dependent, primarily axonal, sensorimotor neuropathy and can be used to quantify its severity.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide26.sections.append(guide26Section1)

        let guide26Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Pharmacologic Management:**\\n• Pain Control:: For painful CIPN, the only medication with consistent evidence of efficacy is **duloxetine**, an SNRI antidepressant. Other neuropathic pain agents like gabapentinoids and tricyclic antidepressants may also be trialed.\\n• Topical agents like menthol or capsaicin cream can sometimes provide relief.\\n• **Rehabilitation Management:**\\n• Physical and Occupational Therapy:: This is a critical component of management. Therapy focuses on:\\n• Balance Training:: To reduce the risk of falls.\\n• Strengthening:: To address any motor weakness.\\n• Gait Training:: Including the prescription of an Ankle-Foot Orthosis (AFO) for foot drop.\\n• Adaptive Strategies:: Teaching patients how to compensate for sensory loss to perform ADLs safely.\\n• Oncologic Management:: The development of severe CIPN is often a dose-limiting toxicity. The oncologist may need to reduce the dose, delay treatment, or switch to a less neurotoxic agent to prevent further nerve damage.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide26.sections.append(guide26Section2)

        let guide26Section3 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Low Back Pain: A Diagnostic and Management Framework (for comparison of neuropathic symptoms).\\n• Referenced Assessment Tools: Manual Muscle Testing, Electrodiagnostic Studies (NCS/EMG).",
            displayType: .list,
            orderIndex: 3
        )
        guide26.sections.append(guide26Section3)

        let guide26Section4 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 4
        )
        guide26.sections.append(guide26Section4)
        context.insert(guide26)

        // Assessment Tools

        let assessment0 = MedicalContent(
            title: "Functional Independence Measure (FIM)",
            subtitle: nil,
            contentType: .assessment,
            category: "Assessment Tools",
            overview: "",
            keywords: []
        )

        let assessment0Section0 = ContentSection(
            title: "Purpose and Clinical Indication",
            content: "The Functional Independence Measure (FIM) is a globally recognized, 18-item ordinal scale designed to provide a uniform system for measuring disability. Its structured, 7-level framework allows physicians, nurses, physical therapists, occupational therapists, and speech-language pathologists to communicate a patient's functional status and assistance needs with a single, universally understood metric. Its primary purpose is to assess a patient's level of independence in performing basic activities of daily living (ADLs) and to quantify the amount of assistance they require. It is used extensively in inpatient rehabilitation facilities to track functional progress from admission to discharge and to evaluate the effectiveness of the rehabilitation program. It is validated for use in numerous populations, including stroke, traumatic brain injury (TBI), spinal cord injury (SCI), and amputation.",
            displayType: .text,
            orderIndex: 0
        )
        assessment0.sections.append(assessment0Section0)

        let assessment0Section1 = ContentSection(
            title: "Step-by-Step Description of Assessment",
            content: "The FIM must be administered by a trained and certified clinician or by a consensus of the interdisciplinary team. The score should reflect the patient's  \n\nactual performance of a task on a consistent basis, not what they could potentially do under ideal circumstances. Assessment is typically based on direct observation over a 24-72 hour period.  \n\nThe 18 items are organized into two domains :  \n\n1. Motor Domain (13 items):  \n    Self-Care: Eating, Grooming, Bathing, Dressing–Upper Body, Dressing–Lower Body, Toileting.  \n    Sphincter Control: Bladder Management, Bowel Management.  \n    Transfers: Bed/Chair/Wheelchair, Toilet, Tub/Shower.  \n    Locomotion: Walk/Wheelchair, Stairs.  \n2. Cognitive Domain (5 items):  \n    Communication: Comprehension, Expression.  \n    Social Cognition: Social Interaction, Problem Solving, Memory.",
            displayType: .text,
            orderIndex: 1
        )
        assessment0.sections.append(assessment0Section1)

        let assessment0Row2_0 = TableRow(cells: ["Level", "Description", "Patient's Contribution / Details"], isHeader: true)
        let assessment0Row2_1 = TableRow(cells: [":----", ":----", ":----"], isHeader: false)
        let assessment0Row2_2 = TableRow(cells: ["**No Helper**"], isHeader: false)
        let assessment0Row2_3 = TableRow(cells: ["7", "**Complete Independence**", "Patient safely performs all parts of the task with no modification, assistive device, or help, and does so in a reasonable amount of time."], isHeader: false)
        let assessment0Row2_4 = TableRow(cells: ["6", "**Modified Independence**", "Patient requires an assistive device (e.g., walker, adapted utensil), takes more than a reasonable amount of time, or there are safety considerations. The patient performs 100% of the effort."], isHeader: false)
        let assessment0Row2_5 = TableRow(cells: ["**Helper Required**"], isHeader: false)
        let assessment0Row2_6 = TableRow(cells: ["5", "**Supervision or Setup**", "Patient requires no more than standby assistance, cueing, or coaxing. The helper does not provide physical contact. This includes setting up items for the task. The patient performs 100% of the effort."], isHeader: false)
        let assessment0Row2_7 = TableRow(cells: ["4", "**Minimal Contact Assistance**", "Patient requires incidental hands-on help. The patient performs 75% or more of the task."], isHeader: false)
        let assessment0Row2_8 = TableRow(cells: ["3", "**Moderate Assistance**", "Patient requires more help than incidental touching. The patient performs 50% to 74% of the task."], isHeader: false)
        let assessment0Row2_9 = TableRow(cells: ["2", "**Maximal Assistance**", "Patient performs 25% to 49% of the task."], isHeader: false)
        let assessment0Row2_10 = TableRow(cells: ["1", "**Total Assistance**", "Patient performs less than 25% of the effort, or requires two helpers. Also used if the activity does not occur for any reason."], isHeader: false)
        let assessment0Section2 = ContentSection(
            title: "Detailed Scoring and Interpretation",
            content: "",
            displayType: .table,
            tableData: [assessment0Row2_0, assessment0Row2_1, assessment0Row2_2, assessment0Row2_3, assessment0Row2_4, assessment0Row2_5, assessment0Row2_6, assessment0Row2_7, assessment0Row2_8, assessment0Row2_9, assessment0Row2_10],
            orderIndex: 2
        )
        assessment0.sections.append(assessment0Section2)

        let assessment0Section3 = ContentSection(
            title: "Clinical Pearls, Contraindications, or Pitfalls",
            content: "• Proprietary Instrument: The FIM™ is a proprietary tool owned by the Uniform Data System for Medical Rehabilitation (UDSMR). Official use requires licensing, and clinicians must be trained and pass a credentialing exam to ensure reliable scoring.\\n• FIM vs. FAM: The Functional Assessment Measure (FAM) was developed to address ceiling effects of the FIM, especially in the TBI population. It is not a standalone tool but adds 12 items (mostly cognitive and psychosocial) to the 18 FIM items, creating the 30-item FIM+FAM.\\n• Score the Lower Level: If a patient's performance varies between two levels over the assessment period, the lower (more dependent) score should be assigned.\\n• \"Activity Does Not Occur\": If a task is not performed (e.g., patient is NPO and does not eat, or never encounters stairs), the item is scored as 1\\. This is a common point of confusion for trainees.\\n• Section GG: While the FIM has been largely superseded by \"Section GG\" for regulatory and payment purposes in many U.S. post-acute care settings, its conceptual framework and scoring principles remain foundational to rehabilitation medicine globally.",
            displayType: .list,
            orderIndex: 3
        )
        assessment0.sections.append(assessment0Section3)

        let assessment0Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Applicable in Guides: Stroke Rehabilitation, Spinal Cord Injury Medicine, Brain Injury Medicine, Amputee Care, Pediatric Rehabilitation, Cancer Rehabilitation.",
            displayType: .list,
            orderIndex: 4
        )
        assessment0.sections.append(assessment0Section4)

        let assessment0Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        assessment0.sections.append(assessment0Section5)
        context.insert(assessment0)

        let assessment1 = MedicalContent(
            title: "Modified Ashworth Scale (MAS)",
            subtitle: nil,
            contentType: .assessment,
            category: "Assessment Tools",
            overview: "",
            keywords: []
        )

        let assessment1Section0 = ContentSection(
            title: "Purpose and Clinical Indication",
            content: "The Modified Ashworth Scale (MAS) is a clinical tool used to grade muscle tone by assessing the amount of resistance felt during passive soft-tissue stretching. It is the most widely utilized scale for spasticity in clinical and research settings, largely due to its simplicity and speed of administration. It is used across various neurological conditions, including stroke, spinal cord injury, traumatic brain injury, cerebral palsy, and multiple sclerosis, to quantify tone and track changes in response to interventions like botulinum toxin injections or oral medications.",
            displayType: .text,
            orderIndex: 0
        )
        assessment1.sections.append(assessment1Section0)

        let assessment1Section1 = ContentSection(
            title: "Step-by-Step Description of Assessment",
            content: "To improve reliability, a standardized procedure should be followed :  \n\n1. Positioning: Place the patient in a supine position on an examination table. Ensure the patient is as relaxed as possible.    \n2. Starting Position: To test a muscle group that primarily flexes a joint (e.g., elbow flexors), begin with that joint in a position of maximal flexion. To test an extensor group (e.g., knee extensors), begin with the joint in maximal extension.    \n3. Movement: Move the limb through its full passive range of motion (PROM) at a consistent, rapid speed. The movement should be completed in approximately one second, which can be standardized by counting \"one-thousand-one\" during the motion.    \n4. Scoring: Assign a grade based on the resistance felt during the passive movement.  \n5. Avoid Repetition: Multiple rapid movements should be avoided, as stretching can temporarily alter muscle tone and affect the accuracy of the score.",
            displayType: .text,
            orderIndex: 1
        )
        assessment1.sections.append(assessment1Section1)

        let assessment1Row2_0 = TableRow(cells: ["Grade", "Description"], isHeader: true)
        let assessment1Row2_1 = TableRow(cells: [":----", ":----"], isHeader: false)
        let assessment1Row2_2 = TableRow(cells: ["**0**", "No increase in muscle tone."], isHeader: false)
        let assessment1Row2_3 = TableRow(cells: ["**1**", "Slight increase in muscle tone, manifested by a catch and release or by minimal resistance at the end of the range of motion when the affected part is moved in flexion or extension."], isHeader: false)
        let assessment1Row2_4 = TableRow(cells: ["**1+**", "Slight increase in muscle tone, manifested by a catch, followed by minimal resistance throughout the remainder (less than half) of the ROM."], isHeader: false)
        let assessment1Row2_5 = TableRow(cells: ["**2**", "More marked increase in tone through most of the ROM, but affected part(s) easily moved."], isHeader: false)
        let assessment1Row2_6 = TableRow(cells: ["**3**", "Considerable increase in tone, passive movement difficult."], isHeader: false)
        let assessment1Row2_7 = TableRow(cells: ["**4**", "Affected part(s) rigid in flexion or extension."], isHeader: false)
        let assessment1Section2 = ContentSection(
            title: "Detailed Scoring and Interpretation",
            content: "",
            displayType: .table,
            tableData: [assessment1Row2_0, assessment1Row2_1, assessment1Row2_2, assessment1Row2_3, assessment1Row2_4, assessment1Row2_5, assessment1Row2_6, assessment1Row2_7],
            orderIndex: 2
        )
        assessment1.sections.append(assessment1Section2)

        let assessment1Section3 = ContentSection(
            title: "Clinical Pearls, Contraindications, or Pitfalls",
            content: "• Subjectivity and Reliability: The primary limitation of the MAS is its questionable reliability and validity. Inter-rater reliability is often poor to moderate. The subjective nature of \"feeling\" resistance makes it difficult to standardize between examiners.\\n• Failure to Differentiate Spasticity from Contracture: The definition of spasticity includes velocity-dependence, a factor the MAS does not formally account for. The scale measures total resistance to passive movement, which is a composite of both neural factors (spasticity) and mechanical factors (muscle stiffness, soft-tissue contracture). Therefore, the MAS cannot distinguish between true spasticity and a stiff, contracted joint.\\n• Ordinality Issues: The inclusion of the \"1+\" grade has been criticized for disrupting the ordinal nature of the scale, as the distinction between a grade of 1 and 1+ can be ambiguous and unreliable.\\n• Limited Sensitivity: The 0-4 grading system is not very sensitive to detecting small but clinically meaningful changes in spasticity following an intervention.\\n• Clinical Utility: Despite its psychometric limitations, the MAS remains prevalent because it is fast, requires no equipment, and can be easily integrated into any physical examination. It provides a common, albeit imperfect, language for communicating about muscle tone.",
            displayType: .list,
            orderIndex: 3
        )
        assessment1.sections.append(assessment1Section3)

        let assessment1Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Applicable in Guides: Post-Stroke Spasticity, Spasticity Management in SCI, Spasticity Management in Brain Injury, Cerebral Palsy.\\n• Referenced Assessment Tools: Tardieu Scale.",
            displayType: .list,
            orderIndex: 4
        )
        assessment1.sections.append(assessment1Section4)

        let assessment1Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        assessment1.sections.append(assessment1Section5)
        context.insert(assessment1)

        let assessment2 = MedicalContent(
            title: "Tardieu Scale / Modified Tardieu Scale (MTS)",
            subtitle: nil,
            contentType: .assessment,
            category: "Assessment Tools",
            overview: "",
            keywords: []
        )

        let assessment2Section0 = ContentSection(
            title: "Purpose and Clinical Indication",
            content: "The Tardieu Scale, and its modified version (MTS), is a clinical assessment for measuring spasticity that is considered more valid than the Modified Ashworth Scale because it directly incorporates the concept of velocity-dependence. Its primary purpose is to quantify muscle tone by assessing the muscle's reaction to passive stretch at different speeds. Critically, it allows the clinician to differentiate between the  \n\ndynamic component of increased tone (i.e., true spasticity, which is velocity-dependent) and the static component (i.e., fixed muscle shortening or contracture). It is indicated for any patient with an upper motor neuron lesion where a more precise characterization of spasticity is needed to guide treatment, such as differentiating the need for anti-spasticity agents versus serial casting for contracture.",
            displayType: .text,
            orderIndex: 0
        )
        assessment2.sections.append(assessment2Section0)

        let assessment2Section1 = ContentSection(
            title: "Step-by-Step Description of Assessment",
            content: "The assessment involves moving the target joint through its passive range of motion at three distinct velocities, measuring both the quality of the muscle reaction and the joint angles.  \n\n1. Positioning: Position the patient comfortably to ensure muscle relaxation. For lower extremities, the patient is typically supine; for upper extremities, the patient may be sitting or supine.    \n2. Velocity V1 (Slow Stretch): Move the joint as slowly as possible through its full passive range of motion (PROM). This slow movement should not elicit a stretch reflex. Measure the final angle of full PROM with a goniometer. This angle is recorded as R2.    \n3. Velocity V2 (Gravity Speed): Allow the limb segment to move at the speed of gravity (i.e., let it drop). Note the quality of muscle reaction and the angle of catch, if any.    \n4. Velocity V3 (Fast Stretch): Move the joint as fast as possible through the range of motion. This rapid stretch is intended to elicit the spastic catch. Note the quality of the muscle reaction (e.g., catch, clonus) and measure the precise joint angle at which this reaction first occurs with a goniometer. This angle is recorded as R1.",
            displayType: .text,
            orderIndex: 1
        )
        assessment2.sections.append(assessment2Section1)

        let assessment2Row2_0 = TableRow(cells: ["Grade", "Description"], isHeader: true)
        let assessment2Row2_1 = TableRow(cells: [":----", ":----"], isHeader: false)
        let assessment2Row2_2 = TableRow(cells: ["**0**", "No resistance throughout the course of the passive movement."], isHeader: false)
        let assessment2Row2_3 = TableRow(cells: ["**1**", "Slight resistance throughout the course of the passive movement, with no clear catch at a precise angle."], isHeader: false)
        let assessment2Row2_4 = TableRow(cells: ["**2**", "Clear catch at a precise angle, interrupting the passive movement, followed by release."], isHeader: false)
        let assessment2Row2_5 = TableRow(cells: ["**3**", "Fatigable clonus (lasting \\< 10 seconds when pressure is maintained) occurring at a precise angle."], isHeader: false)
        let assessment2Row2_6 = TableRow(cells: ["**4**", "Infatigable clonus (lasting \\> 10 seconds when maintaining pressure) occurring at a precise angle."], isHeader: false)
        let assessment2Section2 = ContentSection(
            title: "Detailed Scoring and Interpretation",
            content: "",
            displayType: .table,
            tableData: [assessment2Row2_0, assessment2Row2_1, assessment2Row2_2, assessment2Row2_3, assessment2Row2_4, assessment2Row2_5, assessment2Row2_6],
            orderIndex: 2
        )
        assessment2.sections.append(assessment2Section2)

        let assessment2Section3 = ContentSection(
            title: "Clinical Pearls, Contraindications, or Pitfalls",
            content: "• Superiority over MAS: The Tardieu Scale is psychometrically superior to the MAS for measuring spasticity because it operationalizes the definition of spasticity (velocity-dependence) and distinguishes it from contracture. This distinction is critical for appropriate treatment selection.\\n• Complexity and Time: The main barrier to its widespread clinical use is that it is more time-consuming and technically demanding to perform correctly than the MAS. It requires a goniometer and skill in applying consistent stretch velocities.\\n• Reliability: Like any manual test, its reliability depends on the examiner's experience and consistent application of the procedure. Inter-rater reliability for the angle measurements can be variable.\\n• Documentation: A complete Tardieu score should be documented with all three components, for example: \"Left Ankle Plantarflexors: Quality=3, R1=-5°, R2=10°,\" indicating clonus that occurs at 5 degrees of dorsiflexion, while the full passive range is 10 degrees of dorsiflexion.",
            displayType: .list,
            orderIndex: 3
        )
        assessment2.sections.append(assessment2Section3)

        let assessment2Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Applicable in Guides: Post-Stroke Spasticity, Spasticity Management in SCI, Spasticity Management in Brain Injury, Cerebral Palsy.\\n• Referenced Assessment Tools: Modified Ashworth Scale (MAS).",
            displayType: .list,
            orderIndex: 4
        )
        assessment2.sections.append(assessment2Section4)

        let assessment2Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        assessment2.sections.append(assessment2Section5)
        context.insert(assessment2)

