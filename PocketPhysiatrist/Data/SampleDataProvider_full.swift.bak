        let assessment4Section3 = ContentSection(
            title: "Clinical Pearls, Contraindications, or Pitfalls",
            content: "• Variations: Shorter versions, such as the 2-minute or 12-minute walk test, also exist.\\n• Safety: The test should be stopped if the patient experiences chest pain, intolerable shortness of breath, leg cramps, or dizziness.\\n• Learning Effect: Performance may improve on subsequent tests as the patient becomes more familiar with the procedure.",
            displayType: .list,
            orderIndex: 3
        )
        assessment4.sections.append(assessment4Section3)

