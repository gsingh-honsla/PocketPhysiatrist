        let assessment6Section3 = ContentSection(
            title: "Clinical Pearls, Contraindications, or Pitfalls",
            content: "• Clinical Context: These tests are most useful when interpreted in the context of the patient's history, particularly a report of nocturnal symptoms.\\n• Confirmation: While helpful for clinical diagnosis, the gold standard for confirming CTS and assessing its severity is electrodiagnostic testing (NCS/EMG).",
            displayType: .list,
            orderIndex: 3
        )
        assessment6.sections.append(assessment6Section3)

