            displayType: .list,
            orderIndex: 1
        )
        assessment6.sections.append(assessment6Section1)

        let assessment6Row2_0 = TableRow(cells: ["B", "o", "t", "h", " ", "t", "e", "s", "t", "s", " ", "a", "r", "e", " ", "c", "o", "n", "s", "i", "d", "e", "r", "e", "d", " ", "\"", "p", "o", "s", "i", "t", "i", "v", "e", "\"", " ", "o", "r", " ", "\"", "n", "e", "g", "a", "t", "i", "v", "e", ".", "\"", " ", "A", " ", "p", "o", "s", "i", "t", "i", "v", "e", " ", "r", "e", "s", "u", "l", "t", " ", "f", "o", "r", " ", "e", "i", "t", "h", "e", "r", " ", "t", "e", "s", "t", " ", "i", "n", "c", "r", "e", "a", "s", "e", "s", " ", "t", "h", "e", " ", "c", "l", "i", "n", "i", "c", "a", "l", " ", "s", "u", "s", "p", "i", "c", "i", "o", "n", " ", "f", "o", "r", " ", "C", "T", "S", "."], isHeader: true)
        let assessment6Row2_1 = TableRow(cells: ["A", " ", "n", "e", "g", "a", "t", "i", "v", "e", " ", "r", "e", "s", "u", "l", "t", " ", "d", "o", "e", "s", " ", "n", "o", "t", " ", "r", "u", "l", "e", " ", "o", "u", "t", " ", "C", "T", "S", ",", " ", "a", "s", " ", "t", "h", "e", " ", "s", "e", "n", "s", "i", "t", "i", "v", "i", "t", "y", " ", "o", "f", " ", "t", "h", "e", "s", "e", " ", "t", "e", "s", "t", "s", " ", "c", "a", "n", " ", "b", "e", " ", "v", "a", "r", "i", "a", "b", "l", "e", "."], isHeader: false)
        let assessment6Section2 = ContentSection(
