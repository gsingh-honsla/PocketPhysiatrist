        let assessment4 = MedicalContent(
            title: "6-Minute Walk Test (6MWT)",
            subtitle: nil,
            contentType: .assessment,
            category: "Assessment Tools",
            overview: "",
            keywords: []
        )

        let assessment4Section0 = ContentSection(
            title: "Purpose and Clinical Indication",
            content: "The 6-Minute Walk Test (6MWT) is a submaximal exercise test used to assess aerobic capacity and endurance. It measures the distance a patient can walk quickly on a flat, hard surface in a period of 6 minutes. It is a practical and well-tolerated test used across many populations, including stroke, cardiopulmonary disease, and geriatric patients, to evaluate functional exercise capacity and response to interventions.",
            displayType: .text,
            orderIndex: 0
        )
        assessment4.sections.append(assessment4Section0)

        let assessment4Section1 = ContentSection(
            title: "Step-by-Step Description of Assessment",
            content: "",
            displayType: .list,
            orderIndex: 1
