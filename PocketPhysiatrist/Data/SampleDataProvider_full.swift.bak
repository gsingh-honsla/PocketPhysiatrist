import Foundation
import SwiftData

class SampleDataProvider {
    static func populateSampleData(modelContext: ModelContext) {
        // Clear existing data
        try? modelContext.delete(model: MedicalContent.self)
        
        // Add all real medical content
        createRealMedicalContent(context: modelContext)
    }
    
    static func createRealMedicalContent(context: ModelContext) {
        // Categories (Clinical Guides)

        let guide0 = MedicalContent(
            title: "Autonomic Dysreflexia (AD)",
            subtitle: nil,
            contentType: .category,
            category: "Spinal Cord Injury (SCI) Medicine",
            overview: "A rotation on the Spinal Cord Injury (SCI) Medicine service provides foundational training in the comprehensive, lifelong management of individuals with both traumatic and non-traumatic myelopathies. The physiatrist functions as the leader of a robust interdisciplinary team, which includes physical and occupational therapists, speech-language pathologists, rehabilitation nurses, psychologists, social workers, and various medical and surgical consultants. The primary objective is to address the multitude of secondary health conditions that arise after SCI, such as neurogenic bladder and bowel dysfunction, spasticity, chronic pain, pressure injuries, and autonomic dysreflexia, with the overarching goal of maximizing the patient's functional independence, community reintegration, and quality of life.  \n\nTrainees on this service will develop expertise across the entire continuum of care, from initial acute care consultations in the trauma bay and intensive care unit to the intensive rehabilitation phase and long-term outpatient management. Core competencies include performing a comprehensive neurological examination, most notably the International Standards for Neurological Classification of Spinal Cord Injury (ISNCSCI) or ASIA exam, and developing a functionally oriented management plan. This plan addresses not only the immediate rehabilitation needs but also the prevention and treatment of lifelong medical complications inherent to this patient population.",
            keywords: []
        )

        let guide0Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Autonomic Dysreflexia (AD) is a potentially life-threatening syndrome characterized by an uncoordinated and exaggerated sympathetic nervous system response to a noxious stimulus below the level of a spinal cord injury (SCI). It is considered a medical emergency requiring immediate treatment to prevent complications such as hypertensive encephalopathy, stroke, seizure, or cardiac arrest. AD typically occurs in individuals with an SCI at or above the sixth thoracic vertebra (T6), as this level is above the major splanchnic sympathetic outflow.  \n\nThe pathophysiology involves a disruption of autonomic regulation. A noxious stimulus below the injury level (e.g., a distended bladder) sends afferent signals to the spinal cord, triggering a massive, uncontrolled sympathetic reflex discharge. This causes widespread vasoconstriction below the level of injury, leading to a rapid and severe rise in blood pressure. In an intact nervous system, baroreceptors would signal the brain to send descending inhibitory signals to counteract this hypertension. However, in an SCI at or above T6, these inhibitory signals are blocked at the site of injury. The brain can only mount a compensatory parasympathetic response  \n\nabove the level of injury, resulting in the classic signs of bradycardia, vasodilation, flushing, and sweating of the face, neck, and shoulders. Below the injury, the vasoconstriction persists, maintaining the dangerous hypertension.  \n\nThe clinical presentation is defined by a sudden, significant increase in blood pressure—typically a rise in systolic pressure of 20-40 mmHg above the individual's baseline. Since the baseline blood pressure for individuals with high-level SCI is often low (e.g., 90-110 mmHg systolic), a systolic pressure of 150 mmHg can represent a hypertensive crisis.  \n\nKey signs and symptoms include :  \n\n Pounding, severe headache  \n Profuse sweating and skin flushing above the level of injury  \n Bradycardia (slow heart rate), though tachycardia can also occur  \n Piloerection (goose bumps)  \n Nasal congestion  \n Blurred vision or spots in the visual fields  \n* Anxiety or a feeling of impending doom\n\nIt is critical to recognize that some individuals may experience \"silent\" AD, with dangerous elevations in blood pressure but minimal or no symptoms.",
            displayType: .text,
            orderIndex: 0
        )
        guide0.sections.append(guide0Section0)

        let guide0Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Triggers",
            content: "• Bladder (Most Common Trigger):: Bladder distension from a blocked or kinked catheter, urinary retention, or a urinary tract infection (UTI) is the most frequent cause. Urological procedures like cystoscopy or urodynamics can also trigger AD.\\n• Bowel:: Fecal impaction, constipation, or even digital stimulation for a bowel program can be potent triggers.\\n• Skin:: Pressure injuries, ingrown toenails, burns, or tight clothing can be sources of noxious stimuli.\\n• Other Causes:: Other triggers include fractures, sexual activity, menstrual cramps, and labor and delivery.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide0.sections.append(guide0Section1)

        let guide0Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Immediate Non-Pharmacologic Steps:**\\n• Sit the patient up:: Immediately raise the head of the bed to 90 degrees or sit the patient upright with legs dangling. This uses orthostatic effects to help lower blood pressure. Lying the patient down is contraindicated.\\n• Loosen restrictive items:: Remove any tight clothing, abdominal binders, or compression stockings.\\n• Monitor blood pressure:: Check blood pressure every 2-5 minutes until the episode resolves.\\n• **Identify and Remove the Noxious Stimulus:**\\n• Check the bladder first:: If an indwelling catheter is present, check for kinks or blockages. If it is not draining, irrigate it with a small amount of sterile saline or change it immediately. If no catheter is in place, one should be inserted immediately, using lidocaine jelly to numb the urethra.\\n• Check the bowel next:: If bladder issues are ruled out, check for fecal impaction. A topical anesthetic should be applied to the rectum before performing a digital rectal exam to avoid worsening the hypertension.\\n• Perform a full body and skin check:: If the cause is not bladder or bowel related, inspect the entire body for other potential triggers.\\n• **Pharmacologic Management:**\\n• If blood pressure remains elevated despite initial measures, rapid-acting antihypertensive agents are required.\\n• First-line agents: include nifedipine (immediate-release) and nitrates (topical nitroglycerin paste applied above the level of injury). These are chosen for their rapid onset and short duration of action, which is crucial as blood pressure can drop quickly once the stimulus is removed.\\n• The patient's blood pressure should be monitored for at least two hours after the episode has resolved to watch for recurrence or rebound hypotension.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide0.sections.append(guide0Section2)

        let guide0Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• The primary complication of AD is a hypertensive crisis, which can lead to stroke, retinal hemorrhage, seizure, myocardial infarction, or death.\\n• Long-term management focuses on prevention by maintaining meticulous bladder, bowel, and skin care programs to avoid triggering stimuli.\\n• Patient and caregiver education is paramount, and individuals at risk should carry an emergency card and have access to a home blood pressure monitor.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide0.sections.append(guide0Section3)

        let guide0Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Neurogenic Bladder Management in SCI, Neurogenic Bowel Management in SCI, Pressure Injury Prevention and Management in SCI.\\n• Referenced Assessment Tools: American Spinal Injury Association (ASIA) Impairment Scale.",
            displayType: .list,
            orderIndex: 4
        )
        guide0.sections.append(guide0Section4)

        let guide0Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide0.sections.append(guide0Section5)
        context.insert(guide0)

        let guide1 = MedicalContent(
            title: "Neurogenic Bladder Management in SCI",
            subtitle: nil,
            contentType: .category,
            category: "Spinal Cord Injury (SCI) Medicine",
            overview: "A rotation on the Spinal Cord Injury (SCI) Medicine service provides foundational training in the comprehensive, lifelong management of individuals with both traumatic and non-traumatic myelopathies. The physiatrist functions as the leader of a robust interdisciplinary team, which includes physical and occupational therapists, speech-language pathologists, rehabilitation nurses, psychologists, social workers, and various medical and surgical consultants. The primary objective is to address the multitude of secondary health conditions that arise after SCI, such as neurogenic bladder and bowel dysfunction, spasticity, chronic pain, pressure injuries, and autonomic dysreflexia, with the overarching goal of maximizing the patient's functional independence, community reintegration, and quality of life.  \n\nTrainees on this service will develop expertise across the entire continuum of care, from initial acute care consultations in the trauma bay and intensive care unit to the intensive rehabilitation phase and long-term outpatient management. Core competencies include performing a comprehensive neurological examination, most notably the International Standards for Neurological Classification of Spinal Cord Injury (ISNCSCI) or ASIA exam, and developing a functionally oriented management plan. This plan addresses not only the immediate rehabilitation needs but also the prevention and treatment of lifelong medical complications inherent to this patient population.",
            keywords: []
        )

        let guide1Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Neurogenic lower urinary tract dysfunction, or neurogenic bladder, is the loss of normal bladder function resulting from the interruption of complex neural pathways connecting the brain, spinal cord, and urinary bladder. It is one of the most significant and potentially life-threatening sequelae of SCI. The clinical presentation is largely determined by the location of the spinal cord lesion relative to the sacral micturition center (S2-S4).  \n\nImmediately following SCI, a period of spinal shock occurs, characterized by flaccidity and areflexia below the level of injury. During this phase, which can last for weeks to months, the bladder is acontractile, leading to urinary retention. The definitive neurogenic bladder pattern emerges only after spinal shock resolves.  \n\nThe two primary patterns of neurogenic bladder are:\n\n1. Upper Motor Neuron (UMN) Bladder: Also known as a spastic or hyperreflexic bladder, this pattern results from lesions above the conus medullaris (approximately T12/L1). The sacral reflex arc remains intact but is disconnected from higher cortical control. This leads to detrusor muscle overactivity (hyperreflexia), causing involuntary bladder contractions at low volumes. A critical and dangerous feature is    \n2. detrusor-sphincter dyssynergia (DSD), where the external urethral sphincter paradoxically contracts during an involuntary detrusor contraction. This functional obstruction generates dangerously high intravesical pressures (often defined as \\>40 cmH2​O), which can cause vesicoureteral reflux, hydronephrosis, and eventual renal failure. The clinical presentation is typically urinary frequency, urgency, and incontinence of small volumes.  \n3. Lower Motor Neuron (LMN) Bladder: Also known as a flaccid or areflexic bladder, this pattern results from damage to the sacral micturition center (S2-S4) or the cauda equina. The reflex arc is disrupted, leading to an acontractile or hypotonic detrusor muscle. The bladder cannot contract to empty, resulting in urinary retention and overdistension. This leads to    \n4. overflow incontinence, where urine leaks out when bladder pressure exceeds outlet resistance. These bladders are typically large-capacity, low-pressure reservoirs.",
            displayType: .text,
            orderIndex: 0
        )
        guide1.sections.append(guide1Section0)

        let guide1Row1_0 = TableRow(cells: ["M", "a", "x", "i", "m", "u", "m", " ", "C", "y", "s", "t", "o", "m", "e", "t", "r", "i", "c", " ", "C", "a", "p", "a", "c", "i", "t", "y", " ", "(", "M", "C", "C", ")", ":", " ", "T", "h", "e", " ", "v", "o", "l", "u", "m", "e", " ", "a", "t", " ", "w", "h", "i", "c", "h", " ", "t", "h", "e", " ", "p", "a", "t", "i", "e", "n", "t", " ", "o", "r", " ", "b", "l", "a", "d", "d", "e", "r", " ", "r", "e", "a", "c", "t", "s", " ", "t", "o", " ", "f", "i", "l", "l", "i", "n", "g", "."], isHeader: true)
        let guide1Row1_1 = TableRow(cells: ["B", "l", "a", "d", "d", "e", "r", " ", "C", "o", "m", "p", "l", "i", "a", "n", "c", "e", ":", " ", "T", "h", "e", " ", "c", "h", "a", "n", "g", "e", " ", "i", "n", " ", "v", "o", "l", "u", "m", "e", " ", "f", "o", "r", " ", "a", " ", "c", "h", "a", "n", "g", "e", " ", "i", "n", " ", "p", "r", "e", "s", "s", "u", "r", "e", " ", "(", "Δ", "V", "/", "Δ", "P", ")", ".", " ", "L", "o", "w", " ", "c", "o", "m", "p", "l", "i", "a", "n", "c", "e", " ", "(", "\\", "<", "2", "0", " ", "m", "L", "/", "c", "m", "H", "2", "​", "O", ")", " ", "i", "n", "d", "i", "c", "a", "t", "e", "s", " ", "a", " ", "s", "t", "i", "f", "f", ",", " ", "u", "n", "s", "a", "f", "e", " ", "b", "l", "a", "d", "d", "e", "r", "."], isHeader: false)
        let guide1Row1_2 = TableRow(cells: ["D", "e", "t", "r", "u", "s", "o", "r", " ", "O", "v", "e", "r", "a", "c", "t", "i", "v", "i", "t", "y", ":", " ", "T", "h", "e", " ", "p", "r", "e", "s", "e", "n", "c", "e", " ", "o", "f", " ", "i", "n", "v", "o", "l", "u", "n", "t", "a", "r", "y", " ", "d", "e", "t", "r", "u", "s", "o", "r", " ", "c", "o", "n", "t", "r", "a", "c", "t", "i", "o", "n", "s", " ", "d", "u", "r", "i", "n", "g", " ", "f", "i", "l", "l", "i", "n", "g", "."], isHeader: false)
        let guide1Row1_3 = TableRow(cells: ["D", "e", "t", "r", "u", "s", "o", "r", " ", "L", "e", "a", "k", " ", "P", "o", "i", "n", "t", " ", "P", "r", "e", "s", "s", "u", "r", "e", " ", "(", "D", "L", "P", "P", ")", ":", " ", "T", "h", "e", " ", "l", "o", "w", "e", "s", "t", " ", "d", "e", "t", "r", "u", "s", "o", "r", " ", "p", "r", "e", "s", "s", "u", "r", "e", " ", "a", "t", " ", "w", "h", "i", "c", "h", " ", "u", "r", "i", "n", "e", " ", "l", "e", "a", "k", "a", "g", "e", " ", "o", "c", "c", "u", "r", "s", " ", "i", "n", " ", "t", "h", "e", " ", "a", "b", "s", "e", "n", "c", "e", " ", "o", "f", " ", "a", " ", "v", "o", "l", "u", "n", "t", "a", "r", "y", " ", "c", "o", "n", "t", "r", "a", "c", "t", "i", "o", "n", ".", " ", "A", " ", "p", "r", "e", "s", "s", "u", "r", "e", " ", "\\", ">", "4", "0", " ", "c", "m", "H", "2", "​", "O", " ", "i", "s", " ", "d", "a", "n", "g", "e", "r", "o", "u", "s", "."], isHeader: false)
        let guide1Row1_4 = TableRow(cells: ["P", "r", "e", "s", "e", "n", "c", "e", " ", "o", "f", " ", "D", "e", "t", "r", "u", "s", "o", "r", "-", "S", "p", "h", "i", "n", "c", "t", "e", "r", " ", "D", "y", "s", "s", "y", "n", "e", "r", "g", "i", "a", " ", "(", "D", "S", "D", ")", ":", " ", "C", "o", "n", "f", "i", "r", "m", "e", "d", " ", "b", "y", " ", "s", "i", "m", "u", "l", "t", "a", "n", "e", "o", "u", "s", " ", "m", "e", "a", "s", "u", "r", "e", "m", "e", "n", "t", " ", "o", "f", " ", "s", "p", "h", "i", "n", "c", "t", "e", "r", " ", "E", "M", "G", " ", "a", "c", "t", "i", "v", "i", "t", "y", " ", "d", "u", "r", "i", "n", "g", " ", "a", " ", "d", "e", "t", "r", "u", "s", "o", "r", " ", "c", "o", "n", "t", "r", "a", "c", "t", "i", "o", "n", "."], isHeader: false)
        let guide1Section1 = ContentSection(
            title: "Key Diagnostic Criteria and Classification Systems",
            content: "",
            displayType: .scale,
            tableData: [guide1Row1_0, guide1Row1_1, guide1Row1_2, guide1Row1_3, guide1Row1_4],
            orderIndex: 1
        )
        guide1.sections.append(guide1Section1)

        let guide1Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• **Conservative Management:**\\n• Intermittent Catheterization (IC):: This is the preferred and safest method for routine bladder emptying. It is typically performed on a timed schedule (every 4-6 hours) to maintain bladder volumes below a target (e.g., 400-500 mL). This method requires adequate hand dexterity, cognitive ability, and motivation, or a reliable caregiver.\\n• Indwelling Catheters:: Used when IC is not feasible. A **suprapubic catheter** is surgically placed through the abdominal wall and is strongly preferred for long-term use over an indwelling urethral catheter to reduce the risk of urethral erosion, strictures, and interference with sexual function. Indwelling catheters must\\n• *never* be clamped in an SCI patient due to the risk of precipitating autonomic dysreflexia.\\n• Behavioral and Fluid Management:: A consistent fluid intake schedule (e.g., 1.8-2 liters per day) is essential for predictable bladder filling. The Credé (suprapubic pressure) and Valsalva maneuvers are generally contraindicated as primary emptying methods because they can generate dangerously high intravesical pressures and lead to complications.\\n• **Pharmacology:**\\n• Anticholinergic/Antimuscarinic Agents (e.g., oxybutynin, solifenacin):: These are the first-line medications for managing detrusor overactivity in UMN bladders. They work by relaxing the bladder muscle, thereby increasing its capacity and reducing high-pressure, incontinent contractions.\\n• Botulinum Toxin A (BoNT-A):: Injections directly into the detrusor muscle via cystoscopy are a highly effective treatment for refractory detrusor overactivity, with effects lasting 6-9 months.\\n• Alpha-Adrenergic Blockers (e.g., tamsulosin):: Can be used to help relax the bladder neck and internal sphincter, which may be beneficial in some patients with DSD.\\n• **Interventional and Surgical Procedures:**\\n• These are considered when conservative and pharmacologic methods fail to create a safe, low-pressure system.\\n• Augmentation Cystoplasty:: A segment of bowel is used to enlarge the bladder, dramatically increasing its capacity and lowering storage pressures.\\n• Sphincterotomy:: The external sphincter is surgically cut to create a low-pressure, incontinent system, which then requires an external collection device (e.g., condom catheter). This is less commonly performed now due to advances in other treatments.\\n• Urinary Diversion (e.g., Ileal Conduit):: Urine is diverted from the bladder to an external ostomy bag. This is typically a last resort.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide1.sections.append(guide1Section2)

        let guide1Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Urinary Tract Infection (UTI):: The most frequent complication. It is critical to distinguish **symptomatic UTI** (fever, malaise, increased spasticity, cloudy/malodorous urine, autonomic dysreflexia) from **asymptomatic bacteriuria**, which is common and should *not* be treated with antibiotics. Management involves a urine culture from a freshly catheterized specimen and appropriate antibiotics for symptomatic infections.\\n• Urolithiasis (Bladder and Kidney Stones):: Risk is increased due to urinary stasis, infection with urea-splitting organisms, and indwelling catheters.\\n• Renal Failure:: The most feared long-term complication, directly resulting from chronic exposure of the kidneys to high bladder pressures and recurrent infections. This is the primary complication that modern bladder management aims to prevent.\\n• Autonomic Dysreflexia (AD):: A medical emergency in patients with lesions at T6 or above. Bladder distension is the most common trigger. Prompt bladder emptying is the first step in management.\\n• Bladder Cancer:: The risk of squamous cell carcinoma is significantly elevated in the SCI population, particularly with chronic indwelling catheter use. This necessitates long-term surveillance with cystoscopy for high-risk individuals.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide1.sections.append(guide1Section3)

        let guide1Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Autonomic Dysreflexia, Spasticity Management in SCI, Pressure Injury Prevention and Management.\\n• Referenced Assessment Tools: American Spinal Injury Association (ASIA) Impairment Scale.",
            displayType: .list,
            orderIndex: 4
        )
        guide1.sections.append(guide1Section4)

        let guide1Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide1.sections.append(guide1Section5)
        context.insert(guide1)

        let guide2 = MedicalContent(
            title: "Neurogenic Bowel Management in SCI",
            subtitle: nil,
            contentType: .category,
            category: "Spinal Cord Injury (SCI) Medicine",
            overview: "A rotation on the Spinal Cord Injury (SCI) Medicine service provides foundational training in the comprehensive, lifelong management of individuals with both traumatic and non-traumatic myelopathies. The physiatrist functions as the leader of a robust interdisciplinary team, which includes physical and occupational therapists, speech-language pathologists, rehabilitation nurses, psychologists, social workers, and various medical and surgical consultants. The primary objective is to address the multitude of secondary health conditions that arise after SCI, such as neurogenic bladder and bowel dysfunction, spasticity, chronic pain, pressure injuries, and autonomic dysreflexia, with the overarching goal of maximizing the patient's functional independence, community reintegration, and quality of life.  \n\nTrainees on this service will develop expertise across the entire continuum of care, from initial acute care consultations in the trauma bay and intensive care unit to the intensive rehabilitation phase and long-term outpatient management. Core competencies include performing a comprehensive neurological examination, most notably the International Standards for Neurological Classification of Spinal Cord Injury (ISNCSCI) or ASIA exam, and developing a functionally oriented management plan. This plan addresses not only the immediate rehabilitation needs but also the prevention and treatment of lifelong medical complications inherent to this patient population.",
            keywords: []
        )

        let guide2Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "Neurogenic bowel dysfunction (NBD) is an almost universal consequence of SCI, resulting from the disruption of neural control over gastrointestinal and anorectal function. It leads to profound constipation, fecal impaction, and a high risk of incontinence, significantly impacting quality of life, social integration, and independence. The clinical presentation and management strategy are dictated by the location of the lesion, which creates two distinct patterns: Upper Motor Neuron (UMN) and Lower Motor Neuron (LMN) bowel.  \n\n1. Upper Motor Neuron (UMN) Bowel: Also known as a \"reflexic\" or \"spastic\" bowel, this pattern occurs with injuries above the conus medullaris (T12/L1). In UMN bowel, the nerve connections between the spinal cord and the colon remain intact. This preserves the spinal defecation reflex arc, but voluntary cortical control over the external anal sphincter (EAS) is lost. The result is a spastic EAS that remains tightly closed, leading to stool retention and chronic constipation. Bowel movements occur on a reflex basis when the rectum is stretched by stool, but they are involuntary and uncoordinated.    \n2. Lower Motor Neuron (LMN) Bowel: Also known as an \"areflexic\" or \"flaccid\" bowel, this pattern results from damage to the sacral defecation center in the conus medullaris or the cauda equina (below T12/L1). This injury disrupts the spinal reflex arc, leading to loss of centrally-mediated peristalsis and a flaccid, atonic EAS. The primary issues are extremely slow stool propulsion, constipation, and a high risk of fecal incontinence, as the loose sphincter cannot prevent leakage when intra-abdominal pressure increases (e.g., during transfers, coughing).",
            displayType: .text,
            orderIndex: 0
        )
        guide2.sections.append(guide2Section0)

        let guide2Section1 = ContentSection(
            title: "Key Diagnostic Criteria",
            content: "• UMN Bowel:: The DRE will reveal a normal or increased (spastic) anal sphincter tone. The bulbocavernosus reflex (BCR) and anocutaneous reflex (ACR) are typically present or hyperactive.\\n• LMN Bowel:: The DRE will reveal a patulous (gaping) anus with decreased or absent sphincter tone. The BCR and ACR are absent.",
            displayType: .keyPoints,
            orderIndex: 1
        )
        guide2.sections.append(guide2Section1)

        let guide2Section2 = ContentSection(
            title: "Comprehensive Rehabilitation Management",
            content: "• Diet and Fluids:: A high-fiber diet (at least 15 grams/day) and adequate fluid intake are foundational to promote colonic transit and optimal stool consistency.\\n• **Oral Medications:**\\n• Stool Softeners (e.g., docusate):: Allow water to penetrate the stool, making it softer and easier to pass.\\n• Stimulant Laxatives (e.g., senna, bisacodyl):: Stimulate the myenteric plexus to promote motility. These are often taken at night to time a bowel movement for the following morning.\\n• Osmotic Laxatives (e.g., polyethylene glycol):: Draw fluid into the colon to soften stool and increase motility.\\n• The goal is to achieve a soft, formed stool (Bristol Stool Scale 3-4).\\n• Bowel Program Techniques for UMN (Reflexic) Bowel:: The program for a UMN bowel is designed to trigger the intact defecation reflex at a planned time.\\n• Rectal Stimulants:: A suppository (e.g., bisacodyl) or a mini-enema is inserted to chemically stimulate the rectum and initiate reflex peristalsis.\\n• Digital Stimulation:: After waiting for the stimulant to take effect (15-20 minutes), digital stimulation is performed by gently inserting a gloved, lubricated finger into the rectum and moving it in a circular motion for about a minute. This is repeated every 5-10 minutes until the bowel is empty. This action is thought to relax the internal anal sphincter and trigger reflex emptying.\\n• Bowel Program Techniques for LMN (Areflexic) Bowel:: The program for an LMN bowel relies on manual removal of stool, as the defecation reflex is absent.\\n• Manual Evacuation:: Stool is manually removed from the rectal vault using a gloved, lubricated finger. This is often performed once or twice daily to prevent incontinence.\\n• Valsalva/Straining:: Gentle straining or increasing intra-abdominal pressure may assist with moving stool down, but should be used with caution.\\n• The goal is a firmer stool consistency to reduce the risk of leakage between bowel care sessions.\\n• **Adjunctive Techniques:**\\n• Abdominal Massage:: Can help stimulate peristalsis and shorten colonic transit time.\\n• Positioning:: Performing bowel care in an upright position on a commode or toilet utilizes gravity to assist with evacuation.",
            displayType: .keyPoints,
            orderIndex: 2
        )
        guide2.sections.append(guide2Section2)

        let guide2Section3 = ContentSection(
            title: "Common Complications and Their Management",
            content: "• Constipation and Fecal Impaction:: The most common complications, managed by adjusting the bowel program (medications, timing, techniques).\\n• Fecal Incontinence:: A major concern, especially in LMN bowel. Managed by ensuring complete and regular emptying and optimizing stool consistency.\\n• Autonomic Dysreflexia:: Bowel distension is a common trigger for AD in individuals with injuries at T6 or above. A well-managed bowel program is a key preventative measure.\\n• Hemorrhoids and Anal Fissures:: Can result from constipation, straining, and digital stimulation.",
            displayType: .keyPoints,
            orderIndex: 3
        )
        guide2.sections.append(guide2Section3)

        let guide2Section4 = ContentSection(
            title: "Cross-Referencing",
            content: "• Relevant Guides: Autonomic Dysreflexia, Pressure Injury Prevention and Management in SCI.\\n• Referenced Assessment Tools: American Spinal Injury Association (ASIA) Impairment Scale.",
            displayType: .list,
            orderIndex: 4
        )
        guide2.sections.append(guide2Section4)

        let guide2Section5 = ContentSection(
            title: "References",
            content: "",
            displayType: .list,
            orderIndex: 5
        )
        guide2.sections.append(guide2Section5)
        context.insert(guide2)

        let guide3 = MedicalContent(
            title: "Pressure Injury Prevention and Management in SCI",
            subtitle: nil,
            contentType: .category,
            category: "Spinal Cord Injury (SCI) Medicine",
            overview: "A rotation on the Spinal Cord Injury (SCI) Medicine service provides foundational training in the comprehensive, lifelong management of individuals with both traumatic and non-traumatic myelopathies. The physiatrist functions as the leader of a robust interdisciplinary team, which includes physical and occupational therapists, speech-language pathologists, rehabilitation nurses, psychologists, social workers, and various medical and surgical consultants. The primary objective is to address the multitude of secondary health conditions that arise after SCI, such as neurogenic bladder and bowel dysfunction, spasticity, chronic pain, pressure injuries, and autonomic dysreflexia, with the overarching goal of maximizing the patient's functional independence, community reintegration, and quality of life.  \n\nTrainees on this service will develop expertise across the entire continuum of care, from initial acute care consultations in the trauma bay and intensive care unit to the intensive rehabilitation phase and long-term outpatient management. Core competencies include performing a comprehensive neurological examination, most notably the International Standards for Neurological Classification of Spinal Cord Injury (ISNCSCI) or ASIA exam, and developing a functionally oriented management plan. This plan addresses not only the immediate rehabilitation needs but also the prevention and treatment of lifelong medical complications inherent to this patient population.",
            keywords: []
        )

        let guide3Section0 = ContentSection(
            title: "Core Pathophysiology and Clinical Presentation",
            content: "A pressure injury (PI), formerly known as a pressure ulcer or bedsore, is localized damage to the skin and underlying soft tissue, usually over a bony prominence. Individuals with spinal cord injury (SCI) are at extremely high risk for developing PIs, with over 85% experiencing one in their lifetime. This vulnerability stems from impaired sensation (loss of pain and pressure feedback), paralysis leading to immobility, and muscle atrophy which reduces natural padding over bones.  \n\nThe pathophysiology involves intense and/or prolonged pressure, often combined with shear forces, which compresses tissue between a bony prominence and an external surface (like a bed or wheelchair). This compression obstructs blood flow, leading to tissue ischemia, inflammation, and eventual necrosis (cell death). Injuries can form from the \"top-down,\" where surface friction and pressure damage the epidermis first, or from the \"bottom-up,\" where deep tissue is damaged near the bone long before any changes are visible on the skin surface.",
            displayType: .text,
            orderIndex: 0
        )
        guide3.sections.append(guide3Section0)

        let guide3Row1_0 = TableRow(cells: ["S", "t", "a", "g", "e", " ", "1", ":", " ", "I", "n", "t", "a", "c", "t", " ", "s", "k", "i", "n", " ", "w", "i", "t", "h", " ", "a", " ", "l", "o", "c", "a", "l", "i", "z", "e", "d", " ", "a", "r", "e", "a", " ", "o", "f", " ", "n", "o", "n", "-", "b", "l", "a", "n", "c", "h", "a", "b", "l", "e", " ", "e", "r", "y", "t", "h", "e", "m", "a", " ", "(", "r", "e", "d", "n", "e", "s", "s", ")", ".", " ", "I", "n", " ", "d", "a", "r", "k", "l", "y", " ", "p", "i", "g", "m", "e", "n", "t", "e", "d", " ", "s", "k", "i", "n", ",", " ", "t", "h", "e", " ", "c", "o", "l", "o", "r", " ", "m", "a", "y", " ", "d", "i", "f", "f", "e", "r", " ", "f", "r", "o", "m", " ", "t", "h", "e", " ", "s", "u", "r", "r", "o", "u", "n", "d", "i", "n", "g", " ", "a", "r", "e", "a", ".", " ", "T", "h", "e", " ", "a", "r", "e", "a", " ", "m", "a", "y", " ", "b", "e", " ", "p", "a", "i", "n", "f", "u", "l", ",", " ", "f", "i", "r", "m", ",", " ", "s", "o", "f", "t", ",", " ", "w", "a", "r", "m", "e", "r", ",", " ", "o", "r", " ", "c", "o", "o", "l", "e", "r", " ", "c", "o", "m", "p", "a", "r", "e", "d", " ", "t", "o", " ", "a", "d", "j", "a", "c", "e", "n", "t", " ", "t", "i", "s", "s", "u", "e", "."], isHeader: true)
